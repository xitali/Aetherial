                                                <TextBlock Text="🛠️" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Zaawansowany Tuning Systemu (Hibernacja, VHDX, CompactOS)" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Hibernacja -->
                                        <Border Background="#1A1A24" CornerRadius="6" BorderBrush="#262634" BorderThickness="1" Padding="14,12" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="💤 Zarządzanie Plikiem Hibernacji (hiberfil.sys)" FontSize="15" FontWeight="Bold" Foreground="#E2E4EE" VerticalAlignment="Center" />
                                                        <Border x:Name="HibernationBadgeBorder" Background="#362410" BorderBrush="#78350F" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock x:Name="HibernationStatusBadge" Text="● WŁĄCZONA (~12.5 GB)" FontSize="11" FontWeight="Bold" Foreground="#FFB74D" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="Zajmuje ~12.5 GB na dysku C:. Możesz wyłączyć lub zmniejszyć o połowę zachowując Fast Startup." FontSize="13" Foreground="#9497AB" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Wyłącz (~12.5 GB)" Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0" Click="DisableHibernation_Click" />
                                                    <Button Content="Tryb zredukowany (~6 GB)" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="ReduceHibernation_Click" />
                                                    <Button Content="Włącz pełną" Style="{StaticResource SecondaryButtonStyle}" Click="EnableHibernation_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Kompaktowanie VHDX -->
                                        <Border Background="#1A1A24" CornerRadius="6" BorderBrush="#262634" BorderThickness="1" Padding="14,12" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="🐳 Kompaktowanie Dysków VHDX (Docker &amp; WSL)" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                                                    <TextBlock Text="Obcina puste gigabajty z plików docker_data.vhdx oraz ext4.vhdx po usunięciu kontenerów." FontSize="13" Foreground="#94A3B8" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="📉 Kompaktuj Docker VHDX" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="ShrinkDockerVhdx_Click" />
                                            </Grid>
                                        </Border>

                                        <!-- CompactOS -->
                                        <Border Background="#1A1A24" CornerRadius="6" BorderBrush="#262634" BorderThickness="1" Padding="14,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="🗜️ Bezstratna Kompresja NTFS (CompactOS / XPRESS8K)" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                                                    <TextBlock Text="Wybierz folder. Zostanie skompresowany o 30-50% bez pakowania do ZIP – pliki działają normalnie!" FontSize="13" Foreground="#94A3B8" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="🗜️ Wybierz folder do kompresji" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="CompactFolder_Click" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ==================== WIDOK 5: CENTRUM PROGRAMÓW & AKTUALIZATOR (100 APLIKACJI) ==================== -->
                    <Grid x:Name="ViewApps" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Pasek nagłówka i statusu folderu -->
                            <RowDefinition Height="Auto" /> <!-- Pasek filtrów, wyszukiwarki i akcji masowych -->
                            <RowDefinition Height="*" />    <!-- Lista 100 aplikacji -->
                        </Grid.RowDefinitions>

                        <!-- Pasek informacyjny i docelowy folder -->
                        <Border Grid.Row="0" Background="#111B2C" CornerRadius="8" BorderBrush="#0078D4" BorderThickness="1" Padding="16,12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="📥" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Centrum Oprogramowania &amp; Automatycznych Aktualizacji" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                        <Border Background="#0E7090" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="WINGET NATIVE" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Kompaktowy hub programistyczny, homelab, AI (ChatGPT, Antigravity) oraz narzędzia graficzne dla Windows 11. Cicha instalacja, brak adware, auto-aktualizacje winget." FontSize="13" Foreground="#94A3B8" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="📁 Domyślna ścieżka instalacji:" FontSize="12" Foreground="#88889C" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="AppsTargetFolderText" Text="D:\Programy" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                        <Button Content="⚙️ Zmień w Ustawieniach" Style="{StaticResource SecondaryButtonStyle}" Padding="8,2" FontSize="11" Margin="12,0,0,0" Click="NavToSettings_Click" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#143820" BorderBrush="#166534" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="● ZAWSZE NAJNOWSZE" FontSize="11" FontWeight="Bold" Foreground="#81C784" />
                                    </Border>
                                    <Button Content="🔄 Sprawdź wersje" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="RefreshAppsStatus_Click" />
                                    <Button Content="⚡ ZAKTUALIZUJ WSZYSTKIE DO NAJNOWSZYCH" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="UpgradeAllInstalledApps_Click" ToolTip="Automatycznie pobiera i bezszelestnie aktualizuje wszystkie programy na komputerze do najnowszych wersji" />
                                    <Button Content="📥 Zainstaluj zaznaczone" Style="{StaticResource PrimaryButtonStyle}" Background="#15803D" BorderBrush="#166534" Click="InstallSelectedApps_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Pasek wyszukiwania i kategorii -->
                        <Border Grid.Row="1" Background="#14141E" CornerRadius="8" BorderBrush="#222230" BorderThickness="1" Padding="14,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="AppsSearchTextBox" Background="#1C1C28" Foreground="#FFFFFF" BorderBrush="#2C2C3E" BorderThickness="1" Padding="10,6" FontSize="13" TextChanged="AppsSearchTextBox_TextChanged" VerticalAlignment="Center" ToolTip="Wpisz nazwę programu, technologię lub kategorię..." />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <Button Content="Zaznacz widoczne" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11" Margin="0,0,6,0" Click="SelectVisibleApps_Click" />
                                        <Button Content="Odznacz wszystkie" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11" Click="DeselectAllApps_Click" />
                                    </StackPanel>
                                </Grid>

                                <!-- Kafelki kategorii -->
                                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                    <Button Content="Wszystkie (140+)" Tag="All" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,6,4" FontSize="12" Click="FilterCategory_Click" />
                                    <Button Content="🖥️ Serwer Domowy &amp; Homelab" Tag="Serwer Domowy" Style="{StaticResource PrimaryButtonStyle}" Background="#0369A1" BorderBrush="#0284C7" Padding="10,4" Margin="0,0,6,4" FontSize="12" Click="FilterCategory_Click" />
                                    <Button Content="🤖 AI &amp; Antigravity" Tag="AI" Style="{StaticResource PrimaryButtonStyle}" Background="#6D28D9" BorderBrush="#7C3AED" Padding="10,4" Margin="0,0,6,4" FontSize="12" Click="FilterCategory_Click" />
                                    <Button Content="💻 Programowanie &amp; Dev" Tag="Programowanie" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,6,4" FontSize="12" Click="FilterCategory_Click" />
                                    <Button Content="🎨 Grafika &amp; Wideo" Tag="Grafika" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,6,4" FontSize="12" Click="FilterCategory_Click" />
                                    <Button Content="⚡ Narzędzia Systemu" Tag="Systemowe" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,6,4" FontSize="12" Click="FilterCategory_Click" />
                                    <Button Content="🌐 Przeglądarki" Tag="Przeglądarki" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,6,4" FontSize="12" Click="FilterCategory_Click" />
                                    <Button Content="💬 Komunikacja" Tag="Komunikacja" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,6,4" FontSize="12" Click="FilterCategory_Click" />
                                    <Button Content="🎮 Gry &amp; Rozrywka" Tag="Gry" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,6,4" FontSize="12" Click="FilterCategory_Click" />
                                    <Button Content="📄 Biuro &amp; Bezpieczeństwo" Tag="Biuro" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,6,4" FontSize="12" Click="FilterCategory_Click" />
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Lista aplikacji z wirtualizacją -->
                        <Border Grid.Row="2" Background="#12121A" CornerRadius="8" BorderBrush="#20202A" BorderThickness="1" Padding="6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="AppsItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:AppPackageItem}">
                                            <Border Background="#161622" BorderBrush="#242434" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="6" Width="480" MinHeight="110">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    
                                                    <!-- Rząd 1: CheckBox, Ikona, Nazwa, Kategoria -->
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                            <Border Background="#202030" CornerRadius="6" Width="36" Height="36" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Icon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13.5" Foreground="#FFFFFF" TextWrapping="Wrap" LineHeight="17" />
                                                            <TextBlock Text="{Binding Id}" FontSize="10" Foreground="#666677" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        
                                                        <!-- Kategoria -->
                                                        <Border Grid.Column="2" Background="#1E293B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" />
                                                        </Border>
                                                    </Grid>

                                                    <!-- Rząd 2: Opis -->
                                                    <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12" Foreground="#88889C" TextWrapping="Wrap" Margin="46,6,0,8" MaxHeight="38" TextTrimming="CharacterEllipsis" />

                                                    <!-- Rząd 3: Status i Przycisk akcji -->
                                                    <Grid Grid.Row="2" Margin="46,0,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="●" Foreground="{Binding StatusColor}" Margin="0,0,6,0" FontSize="11" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="220" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="{Binding ActionButtonText}" IsEnabled="{Binding CanAction}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="11" Click="InstallSingleApp_Click" Tag="{Binding}" Visibility="{Binding ActionButtonVisible, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- ==================== WIDOK 6: USTAWIENIA SYSTEMU & MODUŁY ROZSZERZONE ==================== -->
                    <Grid x:Name="ViewSettings" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="6,0,10,0">
                                <!-- Nagłówek -->
                                <Border Background="#111B2C" CornerRadius="8" BorderBrush="#0078D4" BorderThickness="1" Padding="18,14" Margin="0,0,0,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="⚙️" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Ustawienia Globalne &amp; Moduły Propozycji Rozwoju" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Zarządzaj domyślną lokalizacją instalacji programów, automatyzacją optymalizacji oraz uruchamiaj zaawansowane audyty gotowe pod obsługę klientów." FontSize="13" Foreground="#94A3B8" />
                                    </StackPanel>
                                </Border>

                                <!-- KARTA 1: Ścieżka instalacji aplikacji -->
                                <Border Background="#161622" CornerRadius="8" BorderBrush="#242434" BorderThickness="1" Padding="18,16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="📁 Domyślny Katalog Instalacji Aplikacji (Winget Custom Location)" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                                        <TextBlock Text="Wszystkie 100 programów z Centrum Oprogramowania będą instalowane do tej ścieżki za pomocą przełącznika --location. Zapobiega to zapełnianiu dysku C:\ i trzyma programy na wybranej partycji (np. D:\ lub E:\)." FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,12" />
                                        
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="SettingsInstallPathTextBox" Background="#1E1E2C" Foreground="#FFFFFF" BorderBrush="#323246" BorderThickness="1" Padding="12,8" FontSize="14" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="📂 Przeglądaj..." Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" VerticalAlignment="Center" Click="BrowseInstallFolder_Click" />
                                            <Button Grid.Column="2" Content="💾 Zapisz ustawienie" Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" VerticalAlignment="Center" Click="SaveInstallFolder_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- KARTA 2: Opcje automatyzacji -->
                                <Border Background="#161622" CornerRadius="8" BorderBrush="#242434" BorderThickness="1" Padding="18,16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="⚡ Opcje Automatyzacji i Bezpieczeństwa" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12" />
                                        
                                        <CheckBox x:Name="OptSilentInstallCheck" Content="Cicha instalacja programów w tle (flagi --silent, brak uciążliwych instalatorów)" IsChecked="True" FontSize="14" Foreground="#D0D0E0" Margin="0,0,0,10" Click="SettingOption_Changed" />
                                        <CheckBox x:Name="OptAutoCheckUpdatesCheck" Content="Sprawdzaj dostępność aktualizacji oprogramowania winget w tle" IsChecked="True" FontSize="14" Foreground="#D0D0E0" Margin="0,0,0,10" Click="SettingOption_Changed" />
                                        <CheckBox x:Name="OptRecycleBinCheck" Content="Bezpieczne usuwanie: przenoś zbędne pliki do Kosza zamiast trwałego niszczenia" IsChecked="True" FontSize="14" Foreground="#D0D0E0" Click="SettingOption_Changed" />
                                    </StackPanel>
                                </Border>

                                <!-- KARTA 3: 4 GOTOWE MODUŁY KLIENTSKIE & PROPOZYCJE ROZWOJU -->
                                <Border Background="#161622" CornerRadius="8" BorderBrush="#242434" BorderThickness="1" Padding="18,16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="💎" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Zaawansowane Moduły Diagnostyczne &amp; Narzędzia Klienckie" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                            <Border Background="#2E7D32" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="PRODUKCYJNE" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Dedykowane narzędzia do profesjonalnej obsługi komputerów klientów, audytów wydajności i utwardzania Windows 11." FontSize="13" Foreground="#94A3B8" Margin="0,0,0,16" />

                                        <UniformGrid Columns="2">
                                            <!-- Moduł 1: Raport audytu -->
                                            <Border Background="#1A1A28" BorderBrush="#2C2C3E" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,12">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Grid.Row="0">
                                                        <TextBlock Text="📑 Komercyjny Raport Audytowy (HTML/PDF)" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                                                        <TextBlock Text="Generuje estetyczny raport stanu PC klienta z marką procesora, pamięcią, stanem wolnego miejsca na dyskach i wyczyszczonymi śmieciami." FontSize="12" Foreground="#88889C" TextWrapping="Wrap" Margin="0,6,0,12" />
                                                    </StackPanel>
                                                    <Button Grid.Row="2" Content="📑 Generuj Raport Klienta (HTML)" Style="{StaticResource PrimaryButtonStyle}" FontSize="13" Padding="12,7" Click="GenerateAuditReport_Click" />
                                                </Grid>
                                            </Border>

                                             <!-- Moduł 2: Tarcza Prywatności Windows 11 -->
                                             <Border Background="#1A1B28" BorderBrush="#282A3E" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,12">
                                                 <Grid>
                                                     <Grid.RowDefinitions>
                                                         <RowDefinition Height="Auto" />
                                                         <RowDefinition Height="*" />
                                                         <RowDefinition Height="Auto" />
                                                     </Grid.RowDefinitions>
                                                     <StackPanel Grid.Row="0">
                                                         <Grid Margin="0,0,0,6">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="*" />
                                                                 <ColumnDefinition Width="Auto" />
                                                             </Grid.ColumnDefinitions>
                                                             <TextBlock Text="🛡️ Tarcza Prywatności Windows 11" FontWeight="Bold" FontSize="14" Foreground="#E2E4EE" VerticalAlignment="Center" />
                                                             <Border x:Name="PrivacyShieldBadgeBorder" Grid.Column="1" Background="#143820" BorderBrush="#166534" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                 <TextBlock x:Name="PrivacyShieldStatusBadge" Text="● WŁĄCZONA (ON)" FontSize="10" FontWeight="Bold" Foreground="#81C784" />
                                                             </Border>
                                                         </Grid>
                                                         <TextBlock Text="Wyłącza telemetrię DiagTrack, śledzenie reklamowe Windows, zbędne usługi diagnostyczne i uwalnia dodatkowe zasoby procesora i dysku." FontSize="12" Foreground="#9497AB" TextWrapping="Wrap" Margin="0,4,0,12" />
                                                     </StackPanel>
                                                     <Button x:Name="PrivacyShieldToggleButton" Grid.Row="2" Content="🛡️ Przełącz Tarczę Prywatności" Style="{StaticResource PrimaryButtonStyle}" Background="#4F46E5" FontSize="13" Padding="12,7" Click="TogglePrivacyShield_Click" />
                                                 </Grid>
                                             </Border>

                                             <!-- Moduł 3: Czujnik Pamięci Windows (Storage Sense) -->
                                             <Border Background="#1A1B28" BorderBrush="#282A3E" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                                                 <Grid>
                                                     <Grid.RowDefinitions>
                                                         <RowDefinition Height="Auto" />
                                                         <RowDefinition Height="*" />
                                                         <RowDefinition Height="Auto" />
                                                     </Grid.RowDefinitions>
                                                     <StackPanel Grid.Row="0">
                                                         <Grid Margin="0,0,0,6">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="*" />
                                                                 <ColumnDefinition Width="Auto" />
                                                             </Grid.ColumnDefinitions>
                                                             <TextBlock Text="🧹 Czujnik Pamięci (Storage Sense)" FontWeight="Bold" FontSize="14" Foreground="#E2E4EE" VerticalAlignment="Center" />
                                                             <Border x:Name="StorageSenseBadgeBorder" Grid.Column="1" Background="#143820" BorderBrush="#166534" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                 <TextBlock x:Name="StorageSenseStatusBadge" Text="● WŁĄCZONY (ON)" FontSize="10" FontWeight="Bold" Foreground="#81C784" />
                                                             </Border>
                                                         </Grid>
                                                         <TextBlock Text="Automatyczne oczyszczanie zbędnych plików tymczasowych i zawartości Kosza w tle Windows 11." FontSize="12" Foreground="#9497AB" TextWrapping="Wrap" Margin="0,4,0,12" />
                                                     </StackPanel>
                                                     <Button x:Name="StorageSenseToggleButton" Grid.Row="2" Content="🧹 Przełącz Czujnik Pamięci" Style="{StaticResource SecondaryButtonStyle}" FontSize="13" Padding="12,7" Click="ToggleStorageSense_Click" />
                                                 </Grid>
                                             </Border>

                                            <!-- Moduł 4: Diagnostyka NVMe S.M.A.R.T. -->
                                            <Border Background="#1A1A28" BorderBrush="#2C2C3E" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Grid.Row="0">
                                                        <TextBlock Text="🩺 Diagnostyka Zdrowia NVMe SSD (S.M.A.R.T.)" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                                                        <TextBlock Text="Odczytuje żywotność komórek pamięci, zużycie (Wear Leveling), temperaturę pracy kontrolera oraz liczbę zapisanych terabajtów (TBW)." FontSize="12" Foreground="#88889C" TextWrapping="Wrap" Margin="0,6,0,12" />
                                                    </StackPanel>
                                                    <Button Grid.Row="2" Content="🩺 Sprawdź Kondycję NVMe" Style="{StaticResource SecondaryButtonStyle}" FontSize="13" Padding="12,7" Click="CheckNvmeHealth_Click" />
                                                </Grid>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- 3. PASEK PODSUMOWANIA & KONSOLA DZIENNIKA (LOG) -->
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Czysty, nienarzucający się pasek stanu na dole -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="GlobalStatusText" Text="Disk Optimizer Suite gotowy do działania." FontSize="14" Foreground="#A0A0B0" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ScanAllButton" Content="🔄 Odśwież stan systemu" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="ScanAllButton_Click" />
                            <Button x:Name="ToggleLogButton" Content="📋 Pokaż dziennik zdarzeń" Style="{StaticResource SecondaryButtonStyle}" Click="ToggleLogButton_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- Konsola logu zdarzeń -->
                    <Border Grid.Row="1" x:Name="LogDrawerBorder" Height="140" Background="#0C0C10" BorderBrush="#1F1F26" BorderThickness="1" CornerRadius="6" Margin="0,10,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="12,6,12,4">
                                <TextBlock Text="DZIENNIK ZDARZEŃ W CZASIE RZECZYWISTYM" FontSize="12" FontWeight="Bold" Foreground="#555566" />
                                <Button Content="Wyczyść log" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="8,3" FontSize="12" Click="ClearLog_Click" />
                            </Grid>
                            <TextBox Grid.Row="1" x:Name="LogTextBox" Background="Transparent" Foreground="#A4B2BC" FontFamily="Consolas, monospace" FontSize="13" BorderThickness="0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="12,0,12,8" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ==================== NOWOCZESNE OKNO MODALNE (MODAL OVERLAY) ==================== -->
        <Grid x:Name="ModalOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="9999">
            <!-- Półprzezroczyste przyciemnione tło -->
            <Border Background="#D008080E" MouseDown="ModalBackdrop_MouseDown" />

            <!-- Nowoczesna karta modalna -->
            <Border Width="580" 
                    MaxWidth="660"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Background="#181824" 
                    BorderBrush="#35354A" 
                    BorderThickness="1" 
                    CornerRadius="12" 
                    Padding="28,24">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="12" Opacity="0.85" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Nagłówek: Ikona + Tytuł -->
                        <RowDefinition Height="*" />    <!-- Treść komunikatu -->
                        <RowDefinition Height="Auto" /> <!-- Przyciski akcji -->
                    </Grid.RowDefinitions>

                    <!-- Nagłówek modala -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
                        <Border x:Name="ModalIconBorder" Background="#252538" CornerRadius="10" Width="52" Height="52" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ModalIconText" Text="❓" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ModalTitleText" Text="Tytuł komunikatu" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap" />
                            <TextBlock x:Name="ModalCategoryText" Text="Disk Optimizer Pro" FontSize="12" Foreground="#88889C" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Treść wiadomości -->
                    <ScrollViewer Grid.Row="1" MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,0,0,26">
                        <TextBlock x:Name="ModalMessageText" 
                                   Text="Treść komunikatu..." 
                                   FontSize="15" 
                                   Foreground="#D0D0E0" 
                                   LineHeight="24" 
                                   TextWrapping="Wrap" />
                    </ScrollViewer>

                    <!-- Przyciski akcji -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ModalCancelButton" 
                                Content="Anuluj" 
                                Style="{StaticResource SecondaryButtonStyle}" 
                                Padding="20,10" 
                                Margin="0,0,12,0" 
                                Click="ModalCancel_Click" />
                        <Button x:Name="ModalConfirmButton" 
                                Content="Potwierdź" 
                                Style="{StaticResource PrimaryButtonStyle}" 
                                Padding="24,10" 
                                Click="ModalConfirm_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== EKRAN OPTYMALIZACJI SYSTEMU (PEŁNOEKRANOWY STYL 30S) ==================== -->
        <Grid x:Name="FullOptimizedOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="9998">
            <Border Background="#F20A0C14" MouseDown="CloseOptimizedOverlay_Click" />
            <Border Width="760" MaxWidth="840" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#141724" BorderBrush="#10B981" BorderThickness="2" CornerRadius="16" Padding="32,26">
                <Border.Effect>
                    <DropShadowEffect Color="#10B981" BlurRadius="45" ShadowDepth="0" Opacity="0.35" />
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <!-- Glowing Icon -->
                    <Grid Width="96" Height="96" Margin="0,0,0,16" HorizontalAlignment="Center">
                        <Ellipse Fill="#10B98115" Stroke="#10B981" StrokeThickness="2" />
                        <TextBlock Text="🛡️" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="TWÓJ SYSTEM JEST W PEŁNI ZOPTYMALIZOWANY!" FontSize="23" FontWeight="ExtraBold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6" TextAlignment="Center" />
                    <TextBlock Text="Procedura 1-Klik z powodzeniem wyczyściła zbędne pamięci podręczne i shadery GPU, odświeżyła bufor resolvera DNS, wykonała optymalizację TRIM dla nośników SSD i uwolniła roboczą pamięć RAM." FontSize="14" Foreground="#94A3B8" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="680" Margin="0,0,0,22" LineHeight="21" />

                    <!-- Grid 4 wyników -->
                    <UniformGrid Columns="4" Margin="0,0,0,18">
                        <Border Background="#1A1E30" BorderBrush="#262D48" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="4">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="ŚMIECI W CACHE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                <TextBlock Text="0 B" FontSize="20" FontWeight="ExtraBold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,4" />
                                <TextBlock Text="100% Czysto" FontSize="11" Foreground="#34D399" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Background="#1A1E30" BorderBrush="#262D48" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="4">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="SHADERY GPU" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                <TextBlock Text="0 B" FontSize="20" FontWeight="ExtraBold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,4" />
                                <TextBlock Text="Zoptymalizowane" FontSize="11" Foreground="#34D399" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Background="#1A1E30" BorderBrush="#262D48" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="4">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="ZWOLNIONE MIEJSCE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                <TextBlock x:Name="OverlayFreedDiskText" Text="1.54 GB" FontSize="20" FontWeight="ExtraBold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,4" />
                                <TextBlock Text="Dysk C: / Kosz / Temp" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Background="#1A1E30" BorderBrush="#262D48" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="4">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="UWOLNIONY RAM" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                <TextBlock x:Name="OverlayFreedRamText" Text="4.2 GB" FontSize="20" FontWeight="ExtraBold" Foreground="#A78BFA" HorizontalAlignment="Center" Margin="0,4" />
                                <TextBlock Text="EmptyWorkingSet" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Pasek bezpieczeństwa -->
                    <Border Background="#0E1F1A" BorderBrush="#10B98140" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="✓ DNS: Wyczyszczony" FontSize="12" FontWeight="SemiBold" Foreground="#34D399" Margin="0,0,16,0" />
                            <TextBlock Text="•" FontSize="12" Foreground="#64748B" Margin="0,0,16,0" />
                            <TextBlock Text="✓ SSD TRIM: Wykonany (Kingston NVMe)" FontSize="12" FontWeight="SemiBold" Foreground="#34D399" Margin="0,0,16,0" />
                            <TextBlock Text="•" FontSize="12" Foreground="#64748B" Margin="0,0,16,0" />
                            <TextBlock Text="✓ CBS &amp; DISM: Ochrona 100% aktywna" FontSize="12" FontWeight="SemiBold" Foreground="#34D399" />
                        </StackPanel>
                    </Border>

                    <!-- Timer info & Przyciski -->
                    <StackPanel HorizontalAlignment="Center">
                        <Border Background="#1E2438" CornerRadius="20" Padding="14,5" Margin="0,0,0,16" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏱️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="OverlayTimerText" Text="Ekran optymalizacji aktywny (pozostało: 30s)..." FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="✓ Przejdź do pulpitu (Esc)" Style="{StaticResource PrimaryButtonStyle}" FontSize="14" Padding="22,10" Margin="0,0,12,0" Click="CloseOptimizedOverlay_Click" />
                            <Button Content="🔍 Sprawdź podzespoły i co poprawić ➔" Style="{StaticResource SecondaryButtonStyle}" FontSize="14" Padding="22,10" Click="OverlayNavToDiagnostics_Click" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

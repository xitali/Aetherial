                        <UniformGrid Columns="2">
                          <Button x:Name="ToolMigrationTile" Tag="0" Click="OpenTool_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="24" Margin="0,0,12,12" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="Przenieś foldery" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Zmień lokalizację dużych folderów." Margin="0,10,0,0" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Button>
                          <Button x:Name="ToolDevTile" Tag="1" Click="OpenTool_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="24" Margin="0,0,0,12" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="Projekty programistyczne" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Znajdź pliki, które można odtworzyć." Margin="0,10,0,0" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Button>
                          <Button x:Name="ToolSystemTile" Tag="2" Click="OpenTool_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="24" Margin="0,0,12,12" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="Opcje systemowe" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Hibernacja, kompresja i dyski wirtualne." Margin="0,10,0,0" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Button>
                          <Button x:Name="ToolMemoryTile" Tag="3" Click="OpenTool_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="24" Margin="0,0,0,12" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="Pamięć RAM" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Sprawdź wykorzystanie pamięci." Margin="0,10,0,0" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Button>
                        </UniformGrid>
                      </StackPanel>
                      <Grid x:Name="ToolDetailPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,18"><Button Content="← Narzędzia" Click="BackToTools_Click" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="Dziennik operacji" Click="ToggleLogButton_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right"/></DockPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="18" Margin="0,0,0,14" d1p1:Name="ToolMigrationSection" Visibility="Collapsed" xmlns:d1p1="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><StackPanel><Grid Margin="0,0,0,12"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="🔗" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock Text="Przenoszenie folderów i dowiązania NTFS" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" /></StackPanel></Grid><TextBlock Text="Kopiuje dane do wskazanej lokalizacji i zachowuje dostęp przez dowiązanie. Zamknij używające folderu programy. Kopia źródłowa pozostaje do czasu ręcznej weryfikacji." FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="34,0,0,14" TextWrapping="Wrap" LineHeight="19" /><ItemsControl x:Name="SymlinkPresetsControl" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type services:SymlinkPreset}"><Border Background="{DynamicResource CardBgBrush}" CornerRadius="6" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="130" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="24" VerticalAlignment="Center" Margin="0,0,14,0" Width="32" TextAlignment="Center" /><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" /><TextBlock Text="{Binding SourcePath, StringFormat={}Źródło: {0}}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" /><TextBlock Text="{Binding SuggestedDestPath, StringFormat={}Cel: {0}}" FontSize="12" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding FormattedSize}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0" /><TextBlock Grid.Column="3" Text="{Binding Status}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0" /><Button Grid.Column="4" Content="Przenieś i stwórz Symlink" Style="{StaticResource PrimaryButtonStyle}" FontSize="13" Padding="12,6" Tag="{Binding}" Click="ExecutePresetRelocation_Click" IsEnabled="{Binding CanRelocate}" VerticalAlignment="Center" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
<Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="18" Margin="0,0,0,14" d1p1:Name="ToolDevSection" Visibility="Collapsed" xmlns:d1p1="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><StackPanel><Grid Margin="0,0,0,12"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="💻" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock Text="Pliki projektów programistycznych" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" /></StackPanel></Grid><TextBlock Text="Wykrywa artefakty na podstawie plików projektu. Przejrzyj listę i zaznacz foldery, które można odtworzyć." FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="34,0,0,14" LineHeight="19" /><Border Background="{DynamicResource CardBgBrush}" CornerRadius="6" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="12,10" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock Text="Folder projektów:" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBox x:Name="DevRootPathTextBox" Text="" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,5" FontSize="13" Width="260" VerticalAlignment="Center" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock Text="Filtr nieaktywności:" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" /><ComboBox x:Name="DevInactiveComboBox" SelectedIndex="0" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="8,4" FontSize="13" VerticalAlignment="Center" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ComboBoxItem Content="Wszystkie projekty" Tag="0" /><ComboBoxItem Content="&gt; 30 dni" Tag="30" /><ComboBoxItem Content="&gt; 60 dni" Tag="60" /><ComboBoxItem Content="&gt; 90 dni" Tag="90" /></ComboBox></StackPanel><Button Grid.Column="2" Content="🔍 Skanuj pakiety" Style="{StaticResource PrimaryButtonStyle}" Click="ScanDevArtifacts_Click" Margin="0,0,10,0" /><Button Grid.Column="3" Content="🧹 Wyczyść zaznaczone pakiety" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Right" Click="CleanDevArtifacts_Click" /></Grid></Border><ItemsControl x:Name="DevArtifactsControl" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type services:DevArtifactItem}"><Border Background="{DynamicResource CardBgBrush}" CornerRadius="6" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,8" Padding="14,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions><CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0" /><TextBlock Grid.Column="1" Text="{Binding TypeIcon}" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0" /><StackPanel Grid.Column="2" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ProjectName}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" /><Border Background="{DynamicResource CardBgBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0"><TextBlock Text="{Binding ArtifactType}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" /></Border></StackPanel><TextBlock Text="{Binding FullPath}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Column="3" Text="{Binding RelativeAgeText}" FontSize="13" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0" /><TextBlock Grid.Column="4" Text="{Binding FormattedSize}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
<Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="18" d1p1:Name="ToolSystemSection" Visibility="Collapsed" xmlns:d1p1="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><StackPanel><Grid Margin="0,0,0,12"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="🛠️" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock Text="Opcje systemowe" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" /></StackPanel></Grid><!-- Hibernacja --><Border Background="{DynamicResource CardBgBrush}" CornerRadius="6" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14,12" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><StackPanel Orientation="Horizontal"><TextBlock Text="💤 Zarządzanie Plikiem Hibernacji (hiberfil.sys)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" /><Border x:Name="HibernationBadgeBorder" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><TextBlock x:Name="HibernationStatusBadge" Text="OCZEKIWANIE NA ODCZYT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}" /></Border></StackPanel><TextBlock Text="Plik hibernacji znajduje się na dysku systemowym. Rozmiar i dostępność odczytasz w skanie czyszczenia." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Wyłącz hibernację" Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0" Click="DisableHibernation_Click" /><Button Content="Tryb zredukowany" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="ReduceHibernation_Click" /><Button Content="Włącz pełną" Style="{StaticResource SecondaryButtonStyle}" Click="EnableHibernation_Click" /></StackPanel></Grid></Border><!-- Kompaktowanie VHDX --><Border Background="{DynamicResource CardBgBrush}" CornerRadius="6" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14,12" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="🐳 Kompaktowanie Dysków VHDX (Docker &amp; WSL)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" /><TextBlock Text="Obcina puste gigabajty z plików docker_data.vhdx oraz ext4.vhdx po usunięciu kontenerów." FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" /></StackPanel><Button Grid.Column="1" Content="📉 Kompaktuj Docker VHDX" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="ShrinkDockerVhdx_Click" /></Grid></Border><!-- CompactOS --><Border Background="{DynamicResource CardBgBrush}" CornerRadius="6" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="🗜️ Bezstratna Kompresja NTFS (CompactOS / XPRESS8K)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" /><TextBlock Text="Kompresja NTFS zachowuje dostęp do plików. Efekt zależy od danych i nie jest gwarantowany." FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" /></StackPanel><Button Grid.Column="1" Content="🗜️ Wybierz folder do kompresji" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="CompactFolder_Click" /></Grid></Border></StackPanel></Border>
                          <Border x:Name="ToolMemorySection" Visibility="Collapsed" Style="{StaticResource SurfaceCardStyle}" Padding="24"><StackPanel><TextBlock Text="Pamięć RAM" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding Text, ElementName=RamStatusText}" Margin="0,20" FontSize="20"/><TextBlock Text="Zwolnienie pamięci procesów może spowolnić kolejne otwarcie ich danych." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20"/><Button Content="Zwolnij pamięć procesów" Click="OptimizeRamNow_Click" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel></Border>
                        </StackPanel></ScrollViewer>
                        <TextBlock Grid.Row="2" Text="{Binding Text, ElementName=GlobalStatusText}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </Grid>
                    </Grid>
                    <!-- ==================== WIDOK 5: CENTRUM PROGRAMÓW & AKTUALIZATOR (100 APLIKACJI) ==================== -->
                    <Grid x:Name="ViewApps" Visibility="Collapsed">
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <DockPanel Margin="0,4,0,22"><Button x:Name="AppsRefreshButton" DockPanel.Dock="Right" Content="Sprawdź aktualizacje" Click="RefreshAppsStatus_Click" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center"/><StackPanel><TextBlock Text="Programy" Style="{StaticResource PageTitleStyle}"/><TextBlock x:Name="AppsStatusText" Text="Sprawdź zainstalowane programy i dostępne wersje." Style="{StaticResource SubtitleStyle}" TextWrapping="Wrap" MaxWidth="660" HorizontalAlignment="Left"/></StackPanel></DockPanel>
                      <StackPanel Grid.Row="1"><DockPanel Margin="0,0,0,16"><TextBox x:Name="AppsSearchTextBox" DockPanel.Dock="Right" Width="240" TextChanged="AppsSearchTextBox_TextChanged" ToolTip="Szukaj programu" AutomationProperties.Name="Szukaj programu"/><StackPanel Orientation="Horizontal"><Button x:Name="AppsInstalledTab" Content="Zainstalowane" Tag="Installed" Click="AppsView_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/><Button x:Name="AppsUpdatesTab" Content="Aktualizacje" Tag="Updates" Click="AppsView_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button x:Name="AppsCatalogTab" Content="Dodaj program" Tag="Catalog" Click="AppsView_Click" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel></DockPanel>
                        <ProgressBar x:Name="AppsReadProgress" IsIndeterminate="True" Height="3" Visibility="Collapsed" Margin="0,0,0,12"/>
                        <TextBlock x:Name="AppsTargetFolderText" Visibility="Collapsed"/>
                      </StackPanel>
                      <Grid Grid.Row="2"><TextBlock x:Name="AppsEmptyText" Text="Użyj przycisku „Sprawdź aktualizacje”, aby odczytać programy." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="500" TextAlignment="Center"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="AppsItemsControl"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type models:AppPackageItem}">
                          <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="6,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanAction}" Visibility="{Binding ActionButtonVisible, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}"/>
                            <Expander Grid.Column="1" Margin="0,0,16,0" HorizontalContentAlignment="Stretch"><Expander.Header><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel></Expander.Header><StackPanel Margin="24,10,0,0"><TextBlock Text="{Binding InstalledVersion, StringFormat={}Zainstalowana wersja: {0}}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/><TextBlock Text="{Binding AvailableVersion, StringFormat={}Dostępna wersja: {0}}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/><TextBlock Text="{Binding Id}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/></StackPanel></Expander>
                            <Button Grid.Column="2" Content="{Binding ActionButtonText}" IsEnabled="{Binding CanAction}" Style="{StaticResource SecondaryButtonStyle}" Padding="14,8" Click="InstallSingleApp_Click" Tag="{Binding}" Visibility="{Binding ActionButtonVisible, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center"/>
                          </Grid></Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                      </Grid>
                      <Border x:Name="AppsSelectionBar" Grid.Row="3" Style="{StaticResource SurfaceCardStyle}" Visibility="Collapsed" Margin="0,12,0,0" Padding="14"><DockPanel><Button Content="Zastosuj zaznaczone" DockPanel.Dock="Right" Click="InstallSelectedApps_Click" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="Odznacz" DockPanel.Dock="Right" Click="DeselectAllApps_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><TextBlock x:Name="AppsSelectionText" VerticalAlignment="Center"/></DockPanel></Border>
                    </Grid>
                    <!-- ==================== WIDOK 6: USTAWIENIA SYSTEMU & MODUŁY ROZSZERZONE ==================== -->
                    <Grid x:Name="ViewSettings" Visibility="Collapsed">
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                      <WrapPanel Margin="0,0,0,14">
                        <Button x:Name="SettingsAppearanceTab" Content="Wygląd i odczyty" Tag="0" Click="SettingsTopic_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button x:Name="SettingsAppsTab" Content="Programy i pliki" Tag="1" Click="SettingsTopic_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button x:Name="SettingsWindowsTab" Content="Windows i raporty" Tag="2" Click="SettingsTopic_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                      </WrapPanel>
                      <ScrollViewer x:Name="SettingsAppearancePage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><views:PreferencesView x:Name="PreferencesPanel" Margin="0,0,0,16" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:DiskOptimizer.Views" /></ScrollViewer>
                      <ScrollViewer x:Name="SettingsAppsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,0,16" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><StackPanel><TextBlock Text="📁 Domyślny Katalog Instalacji Aplikacji (Winget Custom Location)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" /><TextBlock Text="Wybrany folder jest przekazywany instalatorom, które obsługują własną lokalizację. Pakiety Microsoft Store i niektóre instalatory używają folderów systemowych." FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="SettingsInstallPathTextBox" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="12,8" FontSize="14" VerticalAlignment="Center" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" /><Button Grid.Column="1" Content="📂 Przeglądaj..." Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" VerticalAlignment="Center" Click="BrowseInstallFolder_Click" /><Button Grid.Column="2" Content="💾 Zapisz ustawienie" Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" VerticalAlignment="Center" Click="SaveInstallFolder_Click" /></Grid></StackPanel></Border><Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,0,16" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><StackPanel><TextBlock Text="⚡ Opcje Automatyzacji i Bezpieczeństwa" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" /><CheckBox x:Name="OptSilentInstallCheck" Content="Cicha instalacja programów w tle (flagi --silent, brak uciążliwych instalatorów)" IsChecked="True" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" Click="SettingOption_Changed" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" /><CheckBox x:Name="OptAutoCheckUpdatesCheck" Content="Sprawdzaj dostępność aktualizacji oprogramowania winget w tle" IsChecked="True" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" Click="SettingOption_Changed" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" /><CheckBox x:Name="OptRecycleBinCheck" Content="Bezpieczne usuwanie: przenoś zbędne pliki do Kosza zamiast trwałego niszczenia" IsChecked="True" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Click="SettingOption_Changed" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" /></StackPanel></Border></StackPanel></ScrollViewer>
                      <ScrollViewer x:Name="SettingsWindowsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,0,16" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="💎" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="Diagnostyka i ustawienia Windows" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" /><Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="ODCZYTY SYSTEMOWE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" /></Border></StackPanel><TextBlock Text="Dedykowane narzędzia do profesjonalnej obsługi komputerów klientów, audytów wydajności i utwardzania Windows 11." FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" /><UniformGrid Columns="2"><!-- Moduł 1: Raport audytu --><Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Grid.Row="0"><TextBlock Text="📑 Raport komputera (HTML)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" /><TextBlock Text="Generuje estetyczny raport stanu PC klienta z marką procesora, pamięcią, stanem wolnego miejsca na dyskach i wyczyszczonymi śmieciami." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,12" /></StackPanel><Button Grid.Row="2" Content="📑 Eksportuj raport HTML" Style="{StaticResource PrimaryButtonStyle}" FontSize="13" Padding="12,7" Click="GenerateAuditReport_Click" /></Grid></Border><!-- Moduł 2: Tarcza Prywatności Windows 11 --><Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Grid.Row="0"><Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="🛡️ Tarcza Prywatności Windows 11" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" /><Border x:Name="PrivacyShieldBadgeBorder" Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><TextBlock x:Name="PrivacyShieldStatusBadge" Text="OCZEKIWANIE NA ODCZYT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" /></Border></Grid><TextBlock Text="Wyłącza telemetrię DiagTrack, śledzenie reklamowe Windows, zbędne usługi diagnostyczne i uwalnia dodatkowe zasoby procesora i dysku." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,12" /></StackPanel><Button x:Name="PrivacyShieldToggleButton" Grid.Row="2" Content="🛡️ Przełącz Tarczę Prywatności" Style="{StaticResource PrimaryButtonStyle}" Background="{DynamicResource AccentSoftBrush}" FontSize="13" Padding="12,7" Click="TogglePrivacyShield_Click" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" /></Grid></Border><!-- Moduł 3: Czujnik Pamięci Windows (Storage Sense) --><Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Grid.Row="0"><Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="🧹 Czujnik Pamięci (Storage Sense)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" /><Border x:Name="StorageSenseBadgeBorder" Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><TextBlock x:Name="StorageSenseStatusBadge" Text="OCZEKIWANIE NA ODCZYT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" /></Border></Grid><TextBlock Text="Automatyczne oczyszczanie zbędnych plików tymczasowych i zawartości Kosza w tle Windows 11." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,12" /></StackPanel><Button x:Name="StorageSenseToggleButton" Grid.Row="2" Content="🧹 Przełącz Czujnik Pamięci" Style="{StaticResource SecondaryButtonStyle}" FontSize="13" Padding="12,7" Click="ToggleStorageSense_Click" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" /></Grid></Border><!-- Moduł 4: Diagnostyka NVMe S.M.A.R.T. --><Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Grid.Row="0"><TextBlock Text="🩺 Diagnostyka Zdrowia NVMe SSD (S.M.A.R.T.)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" /><TextBlock Text="Wyświetla stan dysków raportowany przez Windows. Zakres danych zależy od sterownika i urządzenia." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,12" /></StackPanel><Button Grid.Row="2" Content="🩺 Sprawdź Kondycję NVMe" Style="{StaticResource SecondaryButtonStyle}" FontSize="13" Padding="12,7" Click="CheckNvmeHealth_Click" /></Grid></Border></UniformGrid></StackPanel></Border></ScrollViewer>
                    </Grid>
                    <!-- ==================== WIDOK 7: KREATOR SKANOWANIA I WYNIKÓW (IObit Wizard) ==================== -->
                    <Grid x:Name="ViewScanner" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Pasek narzędziowy / filtr -->
                            <RowDefinition Height="*" />    <!-- Zawartość: Pasek postępu LUB Lista wyników -->
                        </Grid.RowDefinitions>

                        <!-- Nagłówek skanera -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="16,12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔍" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Centrum analizy i naprawy problemów" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock x:Name="ScannerResultsSummaryBadge" Text="Zainicjuj skanowanie, aby zbadać stan komputera." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="ScannerRestorePointCheck" Content="Utwórz punkt przywracania przed naprawą" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="12" />
                                    <Button x:Name="ScannerFixSelectedButton" Content="⚡  NAPRAW ZAZNACZONE" Style="{StaticResource SuccessButtonStyle}" Padding="20,8" FontSize="13" Click="FixSelected_Click" IsEnabled="False" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Obszar roboczy: Faza 1 (Skanowanie w toku) LUB Faza 2 (Lista wyników) -->
                        <Grid Grid.Row="1">
                            <!-- Faza 1: Panel aktywnego skanowania -->
                            <Border x:Name="ScannerProgressPanel" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="32" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600">
                                    <Border Width="80" Height="80" CornerRadius="40" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center" Margin="0,0,0,20">
                                        <TextBlock Text="⚡" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                    <TextBlock x:Name="ScannerCurrentStepText" Text="Trwa skanowanie komponentów systemu..." FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                    <TextBlock x:Name="ScannerDetailText" Text="Analizowanie lokalizacji tymczasowych, pamięci operacyjnej i urządzeń..." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,20" />
                                    
                                    <ProgressBar x:Name="ScannerProgressBar" Height="10" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,20" Foreground="{DynamicResource AccentBrush}" />
                                    
                                    <Button x:Name="ScannerCancelButton" Content="✕ Anuluj skanowanie" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Center" Padding="18,8" Click="CancelScan_Click" />
                                </StackPanel>
                            </Border>

                            <!-- Faza 2: Lista wyników z checkboxami -->
                            <Border x:Name="ScannerResultsPanel" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Visibility="Visible">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Pasek wyboru i filtrów -->
                                    <Border Grid.Row="0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                        <DockPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox x:Name="ScannerSelectAllCheckBox" Content="Zaznacz wszystkie elementy" IsChecked="True" VerticalAlignment="Center" Click="ScannerSelectAll_Click" Margin="0,0,16,0" />
                                                <TextBlock x:Name="ScannerSelectedCountText" Text="Zaznaczono: 0 pozycji" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Button Content="🔄 Uruchom ponowny skan" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="12,6" FontSize="12" Click="BigScanButton_Click" />
                                        </DockPanel>
                                    </Border>

                                    <!-- Lista pozycji ScanResultItem -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ScannerItemsControl" Margin="12">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:ScanResultItem}">
                                                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,8" Padding="16,12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Checkbox -->
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,16,0" />

                                                            <!-- Severity Badge -->
                                                            <Border Grid.Column="1" Background="{Binding SeverityBg}" CornerRadius="6" Padding="10,4" VerticalAlignment="Center" Margin="0,0,14,0">
                                                                <TextBlock Text="{Binding SeverityBadge}" FontSize="11" FontWeight="Bold" Foreground="{Binding SeverityColor}" />
                                                            </Border>

                                                            <!-- Tytuł, Kategoria, Opis -->
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                            </StackPanel>

                                                            <!-- Rozmiar do odzyskania i status -->
                                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="110" HorizontalAlignment="Right">
                                                                <TextBlock Text="{Binding FormattedSize}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                                                                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{Binding StatusColor}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ==================== WIDOK 8: HISTORIA I AUDYT OPERACJI ==================== -->
                    <Grid x:Name="ViewHistory" Visibility="Collapsed">
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                      <DockPanel Margin="0,4,0,22"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Dziennik zdarzeń" Click="ToggleLogButton_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Odśwież" Click="RefreshHistory_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Wyczyść historię" Click="ClearHistory_Click" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel><StackPanel><TextBlock Text="Historia" Style="{StaticResource PageTitleStyle}"/><TextBlock x:Name="HistoryLastDateText" Text="Brak operacji" Style="{StaticResource SubtitleStyle}"/><TextBlock x:Name="HistoryTotalOpsText" Visibility="Collapsed"/><TextBlock x:Name="HistoryTotalFreedText" Visibility="Collapsed"/></StackPanel></DockPanel>
                      <Grid Grid.Row="1"><TextBlock Text="Tutaj pojawią się wyniki wykonanych operacji." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=HistoryItemsControl}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="HistoryItemsControl"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type models:HistoryEntry}">
                          <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="6,16"><Expander HorizontalContentAlignment="Stretch"><Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding OperationType}" FontWeight="SemiBold"/><TextBlock Text="{Binding FormattedDate}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding StatusBadge}" Foreground="{Binding StatusColor}" VerticalAlignment="Center" Margin="24,0,0,0"/></Grid></Expander.Header><StackPanel Margin="24,12,0,0"><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/><TextBlock Text="{Binding FormattedBytes, StringFormat={}Zwolnione miejsce: {0}}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/></StackPanel></Expander></Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                      </Grid>
                    </Grid>
                </Grid>

                <!-- 3. PASEK PODSUMOWANIA & KONSOLA DZIENNIKA (LOG) -->
                <Grid x:Name="LegacyFooter" Visibility="Collapsed" Grid.Row="3" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Czysty, nienarzucający się pasek stanu na dole -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="GlobalStatusText" MaxWidth="470" TextTrimming="CharacterEllipsis" Text="Aetherial Suite • gotowy do działania" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ScanAllButton" Content="🔄 Odśwież stan systemu" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="ScanAllButton_Click" />
                            <Button x:Name="ToggleLogButton" Content="📋 Pokaż dziennik zdarzeń" Style="{StaticResource SecondaryButtonStyle}" Click="ToggleLogButton_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- Konsola logu zdarzeń -->
                    <Border Grid.Row="1" x:Name="LogDrawerBorder" Height="140" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,10,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="12,6,12,4">
                                <TextBlock Text="DZIENNIK ZDARZEŃ W CZASIE RZECZYWISTYM" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Button Content="Wyczyść log" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="8,3" FontSize="12" Click="ClearLog_Click" />
                            </Grid>
                            <TextBox Grid.Row="1" x:Name="LogTextBox" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas, monospace" FontSize="13" BorderThickness="0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="12,0,12,8" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ==================== NOWOCZESNE OKNO MODALNE (MODAL OVERLAY) ==================== -->
        <Grid x:Name="ModalOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="9999">
            <!-- Półprzezroczyste przyciemnione tło -->
            <Border Background="{DynamicResource CardBgBrush}" MouseDown="ModalBackdrop_MouseDown" />

            <!-- Nowoczesna karta modalna -->
            <Border Width="580"
                    MaxWidth="660"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="28,24">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="12" Opacity="0.85" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Nagłówek: Ikona + Tytuł -->
                        <RowDefinition Height="*" />    <!-- Treść komunikatu -->
                        <RowDefinition Height="Auto" /> <!-- Przyciski akcji -->
                    </Grid.RowDefinitions>

                    <!-- Nagłówek modala -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
                        <Border x:Name="ModalIconBorder" Background="{DynamicResource CardBgBrush}" CornerRadius="10" Width="52" Height="52" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ModalIconText" Text="❓" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ModalTitleText" Text="Tytuł komunikatu" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ModalCategoryText" Text="Aetherial Suite" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Treść wiadomości -->
                    <ScrollViewer Grid.Row="1" MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,0,0,26">
                        <TextBlock x:Name="ModalMessageText"
                                   Text="Treść komunikatu..."
                                   FontSize="15"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   LineHeight="24"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>

                    <!-- Przyciski akcji -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ModalCancelButton"
                                Content="Anuluj"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="20,10"
                                Margin="0,0,12,0"
                                Click="ModalCancel_Click" />
                        <Button x:Name="ModalConfirmButton"
                                Content="Potwierdź"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="24,10"
                                Click="ModalConfirm_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>

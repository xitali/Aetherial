<Window x:Class="DiskOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:views="clr-namespace:DiskOptimizer.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:DiskOptimizer.Models;assembly=Aetherial.Core"
        xmlns:services="clr-namespace:DiskOptimizer.Services;assembly=Aetherial.Services"
        mc:Ignorable="d"
        Title="Aetherial Suite — Przestrzeń i diagnostyka"
        Icon="Assets/app_icon.png"
        Height="1000" Width="1600"
        MinHeight="760" MinWidth="1180"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        FontSize="15"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource BgDarkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" /> <!-- Nowoczesny Cyber Pasek Tytułowy (Aetherial Header) -->
            <RowDefinition Height="*" />  <!-- Główny interfejs (Sidebar + Workspace) -->
        </Grid.RowDefinitions>

        <!-- ==================== NOWOCZESNY PASEK TYTUŁOWY AETHERIAL ==================== -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Lewa strona: Nowe Logo AETHERIAL i podtytuł -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="30" Height="30" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1.5" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Image Source="Assets/app_icon.png" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="AETHERIAL" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text=" SUITE" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="2,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="PORZĄDEK W TWOIM SYSTEMIE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Środek: STORAGE & DIAGNOSTICS DASHBOARD + SYSTEM HEALTH + UPTIME + SECURITY -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="PRZESTRZEŃ I DIAGNOSTYKA" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                            <TextBlock Text="Czas pracy: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock x:Name="TopUptimeText" Text="Odczyt…" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                <!-- Prawa strona: Ustawienia oraz Przyciski sterowania oknem (—, 🗖, Exit) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button x:Name="ThemeToggleButton" Content="◐" ToolTip="Przełącz jasny / ciemny motyw" AutomationProperties.Name="Przełącz motyw" WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TitleBarButtonStyle}" Width="42" Click="ToggleTheme_Click"/>
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="NavToSettings_Click"
                            ToolTip="Ustawienia Aetherial"
                            Width="40" Height="46">
                        <TextBlock Text="⚙" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>

                    <Button x:Name="MinimizeButton"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MinimizeButton_Click"
                            ToolTip="Minimalizuj"
                            Width="48" Height="42"
                            Style="{StaticResource TitleBarButtonStyle}">
                        <TextBlock Text="—" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>

                    <Button x:Name="MaximizeButton"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MaximizeButton_Click"
                            ToolTip="Maksymalizuj / Przywróć"
                            Width="48" Height="42"
                            Style="{StaticResource TitleBarButtonStyle}">
                        <TextBlock x:Name="MaximizeIconText" Text="🗖" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>

                    <Button x:Name="CloseButton"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click"
                            ToolTip="Zamknij program (Exit)"
                            Height="42" Padding="14,0"
                            Style="{StaticResource TitleBarCloseButtonStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Zamknij" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== GŁÓWNA ZAWARTOŚĆ OKNA ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" /> <!-- ~200px SIDEBAR (IObit Style) -->
                <ColumnDefinition Width="*" />   <!-- GŁÓWNY OBSZAR ROBOCZY -->
            </Grid.ColumnDefinitions>

            <!-- ==================== BOCZNY PASEK NAWIGACJI (IObit Style ~200px) ==================== -->
            <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0" Padding="12,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Logo Badge -->
                        <RowDefinition Height="*" />    <!-- Przyciski nawigacyjne -->
                        <RowDefinition Height="Auto" /> <!-- Status Administratora -->
                    </Grid.RowDefinitions>

                    <!-- 1. Logo AETHERIAL z neonowym akcentem -->
                    <Border Grid.Row="0" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,22" ToolTip="Aetherial System Suite">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="Assets/app_icon.png" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="AETHERIAL" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SuccessBrush}" />
                                    <TextBlock Text="{Binding ProductVersion, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="2,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="SYSTEM SUITE" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 2. Menu Modułów (~200px IObit 5-sekcyjny układ) -->
                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="NavDashboardRadio" Style="{StaticResource NavSidebarButtonStyle}" Click="NavButton_Click" Tag="0" ToolTip="Pulpit — Główny wskaźnik zdrowia systemu i 1-klik skan" IsChecked="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="Główna" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavScannerRadio" Style="{StaticResource NavSidebarButtonStyle}" Click="NavButton_Click" Tag="7" ToolTip="Skan — Kreator analizy, wykrywania problemów i naprawy">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="Skan" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavToolsRadio" Style="{StaticResource NavSidebarButtonStyle}" Click="NavButton_Click" Tag="4" ToolTip="Narzędzia — Czyszczenie, Eksplorator, PnP, Symlinki, RAM, Programy">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE90F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="Narzędzia" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavHistoryRadio" Style="{StaticResource NavSidebarButtonStyle}" Click="NavButton_Click" Tag="8" ToolTip="Historia — Dziennik i rejestr operacji optymalizacyjnych">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="Historia" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavSettingsRadio" Style="{StaticResource NavSidebarButtonStyle}" Click="NavButton_Click" Tag="6" ToolTip="Ustawienia — Preferencje, motyw i konfiguracja">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="Ustawienia" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Ukryte referencje dla kompatybilności wstecznej -->
                        <RadioButton x:Name="NavCleanerRadio" Visibility="Collapsed" Tag="1" Click="NavButton_Click" />
                        <RadioButton x:Name="NavExplorerRadio" Visibility="Collapsed" Tag="2" Click="NavButton_Click" />
                        <RadioButton x:Name="NavDriversRadio" Visibility="Collapsed" Tag="3" Click="NavButton_Click" />
                        <RadioButton x:Name="NavAppsRadio" Visibility="Collapsed" Tag="5" Click="NavButton_Click" />
                    </StackPanel>

                    <!-- 3. Status Windows -->
                    <Border Grid.Row="2" CornerRadius="8" Padding="10,8" Background="{DynamicResource AccentSoftBrush}" ToolTip="Aetherial Suite działa lokalnie w systemie Windows.">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🛡️" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="DZIAŁA LOKALNIE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ==================== GŁÓWNY OBSZAR ROBOCZY (WORKSPACE) ==================== -->
            <Grid Grid.Column="1" Margin="22,16,22,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Dyski C, D, E, F -->
                    <RowDefinition Height="*" />    <!-- Przełączane widoki -->
                    <RowDefinition Height="Auto" /> <!-- Nowoczesny pasek stanu i log -->
                </Grid.RowDefinitions>

                <!-- 1. KARTY DYSKÓW (C, D, E, F) - W JEDNYM RZĘDZIE (1-ROW ULTRA-SLICK STATUS STRIP) -->
                <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="12,8" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Etykieta NVMe SSD -->
                        <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" CornerRadius="6" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="10,5" Margin="0,0,10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="CurrentSectionText" Text="PULPIT" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- 4 Partycje w 1 równym rzędzie -->
                        <ItemsControl Grid.Column="1" x:Name="DrivesItemsControl" VerticalAlignment="Center" Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DriveModel}">
                                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="6" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="10,6" Margin="4,3" MinWidth="190">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Nazwa dysku -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="💾" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Pasek zużycia -->
                                            <ProgressBar Grid.Column="1" Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}" Background="{DynamicResource CardBgBrush}" VerticalAlignment="Center" />

                                            <!-- Wolne miejsce -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FormattedFree}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding FormattedTotal, StringFormat={} / {0}}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Podsumowanie Łączne Wolne Miejsce & Przycisk Pełnego Skanowania -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📊" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="DrivesSummaryText" Text="Odczyt wolnego miejsca…" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Button x:Name="MasterScanButton" Content="⚡ Pełne Skanowanie" Style="{StaticResource PrimaryButtonStyle}" Padding="14,6" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" Click="MasterScanAll_Click" ToolTip="Jednym kliknięciem odświeża stan wszystkich partycji, bada zużycie RAM oraz skanuje wszystkie pamięci podręczne i śmieci" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. PRZEŁĄCZANE WIDOKI MODUŁÓW -->
                <Grid Grid.Row="1">

                    <!-- ==================== WIDOK 0: GŁÓWNA (IObit Dashboard: Circular Gauge + Big CTA + 4 Moduły) ==================== -->
                    <Grid x:Name="ViewDashboard" Visibility="Visible">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,12,16">
                                <!-- HERO: Centralny Circular Health Gauge + Big CTA -->
                                <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,0,18" Padding="28,24">
                                    <StackPanel HorizontalAlignment="Center">
                                        <!-- Circular Gauge -->
                                        <Grid Width="210" Height="210" HorizontalAlignment="Center" Margin="0,0,0,16">
                                            <!-- Tło pierścienia -->
                                            <Ellipse Width="210" Height="210" Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="12" />
                                            <!-- Aktywny pierścień z poświatą -->
                                            <Ellipse x:Name="HealthRingEllipse" Width="210" Height="210" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="12">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect Color="#10B981" BlurRadius="22" ShadowDepth="0" Opacity="0.4" />
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <!-- Wartości wewnątrz wskaźnika -->
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock x:Name="HealthScoreText" Text="—" FontSize="52" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" />
                                                <TextBlock x:Name="HealthStatusLabel" Text="OCZEKUJE NA SKAN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                <TextBlock x:Name="HealthIssuesCountText" Text="Gotowy do przeskanowania" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- JEDEN WIELKI PRZYCISK AKCJI (IObit Big CTA) -->
                                        <Button x:Name="DashboardScanBigButton"
                                                Content="▶  SKANUJ TERAZ"
                                                Style="{StaticResource BigCtaButtonStyle}"
                                                HorizontalAlignment="Center"
                                                Click="BigScanButton_Click"
                                                ToolTip="Przeanalizuj pliki tymczasowe i pamięci podręczne, następnie przejrzyj wyniki." />

                                        <!-- Podtytuł statusowy -->
                                        <TextBlock x:Name="DashboardHealthText" Text="System gotowy. Kliknij powyższy przycisk, aby wykryć i rozwiązać problemy." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- 4 KARTY PODSUMOWUJĄCE MODUŁY (W JEDNYM RZĘDZIE) -->
                                <UniformGrid Columns="4" Margin="0,0,0,18">
                                    <!-- Karta 1: Pamięć podręczna i śmieci -->
                                    <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,8,0" Padding="16,14">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="🧹" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="CACHE &amp; PLIKI" Style="{StaticResource EyebrowStyle}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock x:Name="DashCacheText" Text="Nie zeskanowano" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,2" />
                                                <TextBlock x:Name="DashShadersText" Text="Shadery GPU: gotowe" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Row="2" Content="Szczegóły czyszczenia ➔" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="11" Margin="0,10,0,0" Click="NavToCleaner_Click" />
                                        </Grid>
                                    </Border>

                                    <!-- Karta 2: Pamięć RAM -->
                                    <Border Style="{StaticResource SurfaceCardStyle}" Margin="4,0,4,0" Padding="16,14">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="⚡" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="PAMIĘĆ RAM" Style="{StaticResource EyebrowStyle}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock x:Name="RamStatusText" Text="Oczekiwanie na odczyt" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,2" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="EmptyWorkingSet gotowy" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <Button Grid.Row="2" Content="Optymalizuj RAM ➔" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="11" Margin="0,10,0,0" Click="OptimizeRamNow_Click" />
                                        </Grid>
                                    </Border>

                                    <!-- Karta 3: Sprzęt & Urządzenia PnP -->
                                    <Border Style="{StaticResource SurfaceCardStyle}" Margin="4,0,4,0" Padding="16,14">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="🔌" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="SPRZĘT &amp; MAGISTRALA" Style="{StaticResource EyebrowStyle}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock x:Name="DashboardCpuText" Text="Oczekiwanie na odczyt" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                                                <TextBlock x:Name="DashboardGpuText" Text="Oczekiwanie na odczyt" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Row="2" Content="Zarządzaj sprzętem ➔" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="11" Margin="0,10,0,0" Click="NavToDrivers_Click" />
                                        </Grid>
                                    </Border>

                                    <!-- Karta 4: Woluminy & Sieć -->
                                    <Border Style="{StaticResource SurfaceCardStyle}" Margin="8,0,0,0" Padding="16,14">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="🌐" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="SIEĆ &amp; PAMIĘĆ MASOWA" Style="{StaticResource EyebrowStyle}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock x:Name="DashboardNetworkText" Text="Oczekiwanie na odczyt" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                                                <TextBlock x:Name="DashboardSecurityText" Text="Stan nośników: OK" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Row="2" Content="Eksploruj dyski ➔" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="11" Margin="0,10,0,0" Click="NavToExplorer_Click" />
                                        </Grid>
                                    </Border>
                                </UniformGrid>

                                <!-- Sekcja Partycji Dyskowych -->
                                <TextBlock Text="Przestrzeń dyskowa woluminów" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6"/>
                                <TextBlock Text="Rzeczywiste zużycie wykrytych woluminów fizycznych w systemie Windows." Style="{StaticResource SubtitleStyle}" Margin="0,0,0,14"/>
                                <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=DrivesItemsControl}" Margin="-5,0,-5,16">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Border Style="{StaticResource SurfaceCardStyle}" Padding="18,14" Margin="5">
                                            <StackPanel>
                                                <DockPanel><TextBlock Text="{Binding UsedPercent, StringFormat={}{0:0.#}% zajęte}" DockPanel.Dock="Right" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/></DockPanel>
                                                <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Foreground="{DynamicResource TextSecondaryBrush}" Height="6" Margin="0,12,0,10"/>
                                                <DockPanel><TextBlock Text="{Binding FormattedTotal, StringFormat={}Pojemność: {0}}" DockPanel.Dock="Right" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding FormattedFree, StringFormat={}Wolne: {0}}" FontWeight="SemiBold"/></DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Kompatybilność: Złożone kontrolki zachowane dla stabilności -->
                                <Border x:Name="Dash1ClickCardBorder" Visibility="Collapsed">
                                    <StackPanel>
                                        <Border x:Name="Dash1ClickBadge"><TextBlock x:Name="Dash1ClickBadgeText" Text="" /></Border>
                                        <Button x:Name="Dash1ClickButton" Click="AutoOptimize1Click_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Czyszczenie: zakres i wyniki skanowania -->
                    <Grid x:Name="ViewCleaner" Visibility="Collapsed"><views:CleanerView x:Name="CleanerPanel"/></Grid>
<!-- ==================== WIDOK 2: EKSPLORATOR PARTYCJII (DYSKI & GIGANTY) ==================== -->
                    <Grid x:Name="ViewExplorer" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Pasek 1: Wybór partycji & Ścieżka -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Przyciski partycji -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0">
                                    <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=DrivesItemsControl}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding DriveLetter}" Tag="{Binding RootPath}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" Margin="0,0,6,0" Click="SwitchPartition_Click" /></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Ścieżka tekstowa -->
                                <TextBox Grid.Column="1" x:Name="CurrentPathTextBox" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="10,6" FontSize="14" KeyDown="CurrentPathTextBox_KeyDown" VerticalAlignment="Center" />

                                <Button Grid.Column="2" Content="➔ Przejdź" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Margin="8,0,0,0" Click="NavigatePath_Click" />
                                <Button Grid.Column="3" Content="⬆️ W górę" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Margin="8,0,0,0" Click="NavigateUp_Click" />
                            </Grid>
                        </Border>

                        <!-- Pasek 2: Filtry wieku & Akcje usuwania -->
                        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                                <WrapPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,10">
                                    <Button Content="🔍 Pliki giganty (> 500 MB)" Style="{StaticResource PrimaryButtonStyle}" Padding="12,6" Margin="0,0,14,0" Click="FindLargeFiles_Click" />
                                    <TextBlock Text="Zaznacz starsze:" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Button Content="Wszystkie" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,4,0" Tag="0" Click="SelectByAge_Click" />
                                    <Button Content="> 7 dni" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,4,0" Tag="7" Click="SelectByAge_Click" />
                                    <Button Content="> 30 dni" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,4,0" Tag="30" Click="SelectByAge_Click" />
                                    <Button Content="> 90 dni" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,4,0" Tag="90" Click="SelectByAge_Click" />
                                    <Button Content="> 1 rok" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,10,0" Tag="365" Click="SelectByAge_Click" />
                                    <Button Content="Odznacz" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Click="DeselectExplorer_Click" />
                                </WrapPanel>

                                <WrapPanel Grid.Row="1" VerticalAlignment="Center">
                                    <CheckBox x:Name="RecycleBinCheckBox" Content="🗑️ Przenoś do Kosza" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Gdy zaznaczone, usunięte pliki trafią do Kosza (bezpiecznie)" />
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,12,0">
                                        <TextBlock x:Name="ExplorerSelectedSummaryText" Text="Zaznaczono: 0 B (0 el.)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    </Border>
                                    <Button Content="🗑️ Usuń zaznaczone pliki" Style="{StaticResource DangerButtonStyle}" Click="DeleteSelectedExplorerFiles_Click" />
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Lista plików w eksploratorze z tarczą bezpieczeństwa -->
                        <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ExplorerItemsControl" Margin="10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:FileSystemItem}">
                                            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="6" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,6" Padding="12,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="80" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanDelete}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding TypeIcon}" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <TextBlock Grid.Column="3" Text="{Binding ParentDirectory}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{Binding Path}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding FormattedSize}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <TextBlock Grid.Column="5" Text="{Binding FormattedDate}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />

                                                    <Border Grid.Column="6" Background="{Binding AgeBadgeBackground}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding RelativeAgeText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding AgeBadgeColor}" />
                                                    </Border>

                                                    <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Button Content="➔" ToolTip="Wejdź do folderu" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" Margin="0,0,4,0" Tag="{Binding Path}" Click="EnterFolder_Click" Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}" />
                                                        <Button Content="📂" ToolTip="Pokaż w Eksploratorze" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" Tag="{Binding Path}" Click="OpenExplorerPath_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    <StackPanel Grid.Row="3" Margin="0,10,0,0"><ProgressBar x:Name="ExplorerReadProgress" Height="3" Maximum="100" Value="0"/><DockPanel Margin="0,8,0,0"><Button Content="Anuluj odczyt" DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Click="CancelExplorer_Click"/><StackPanel><TextBlock x:Name="ActiveVolumeText" Text="Wybierz wolumin" FontWeight="SemiBold"/><TextBlock x:Name="ExplorerStatusText" Text="Zawartość pojawi się po odczycie." Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></DockPanel></StackPanel></Grid>

                    <!-- ==================== WIDOK 3: SPRZĘT & CENTRUM STEROWNIKÓW (WHQL + PERYFERIA) ==================== -->
                    <Grid x:Name="ViewDrivers" Visibility="Collapsed"><views:HardwareView x:Name="HardwarePanel"/></Grid>
<Grid x:Name="LegacyHardwarePanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Karta specyfikacji stacji -->
                            <RowDefinition Height="Auto" /> <!-- Pasek akcji i centrów producentów -->
                            <RowDefinition Height="*" />    <!-- Główna zawartość z urządzeniami i WHQL -->
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SurfaceCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Sprzęt i sterowniki" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock x:Name="HardwareSummaryText" Text="Skan urządzeń odczyta konfigurację tego komputera." Style="{StaticResource SubtitleStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}" Padding="12" Margin="0,0,0,12"><StackPanel><WrapPanel Margin="0,0,0,8"><Button Content="🔄 Skanuj urządzenia PnP &amp; WHQL" Style="{StaticResource PrimaryButtonStyle}" Click="SearchAllDrivers_Click" Margin="0,0,8,0" Padding="12,6" FontSize="13" /><Button Content="⬇️ Zainstaluj zaznaczone WHQL" Style="{StaticResource DangerButtonStyle}" Click="InstallDriverUpdates_Click" Margin="0,0,8,0" Padding="12,6" FontSize="13" /></WrapPanel><Expander Header="Narzędzia producentów i Menedżer urządzeń" Foreground="{DynamicResource TextSecondaryBrush}"><WrapPanel Margin="0,10,0,0"><Button Content="🎧 MCHOSE Hub" Style="{StaticResource SecondaryButtonStyle}" Click="OpenMchoseHub_Click" Margin="0,0,6,0" Padding="10,5" FontSize="12" ToolTip="Pobierz oficjalne oprogramowanie MCHOSE Audio Hub &amp; Firmware dla zgodnych urządzeń" /><Button Content="🎮 NVIDIA App" Style="{StaticResource SecondaryButtonStyle}" Click="OpenNvidiaApp_Click" Margin="0,0,6,0" Padding="10,5" FontSize="12" ToolTip="Otwórz aplikację NVIDIA z najnowszymi sterownikami Game-Ready" /><Button Content="🌐 Killer Suite" Style="{StaticResource SecondaryButtonStyle}" Click="OpenKillerSuite_Click" Margin="0,0,6,0" Padding="10,5" FontSize="12" ToolTip="Pobierz sterowniki Killer Performance Suite dla zgodnej karty sieciowej" /><Button Content="⚡ AMD Chipset" Style="{StaticResource SecondaryButtonStyle}" Click="OpenAmdChipset_Click" Margin="0,0,6,0" Padding="10,5" FontSize="12" ToolTip="Strona producenta: wybierz sterownik zgodny z wykrytym sprzętem" /><Button Content="🎛️ Menedżer Urządzeń" Style="{StaticResource SecondaryButtonStyle}" Click="OpenDeviceManager_Click" Padding="10,5" FontSize="12" ToolTip="Otwórz Menedżer Urządzeń Windows (devmgmt.msc)" /></WrapPanel></Expander></StackPanel></Border>
                        <!-- Zawartość przewijana: Wykryte urządzenia fizyczne + Aktualizacje WHQL -->
                        <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14">

                                    <!-- ==================== SEKCJA 1: CENTRUM DIAGNOSTYCZNE (100% DYNAMICZNE) ==================== -->
                                    <Border x:Name="DiagnosticsMainBorder" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,18">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock x:Name="DiagnosticsIconText" Text="🟢" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="DiagnosticsHeaderTitle" Text="Diagnostyka urządzeń" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                                                <Border x:Name="DiagnosticsBadgeBorder" Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="DiagnosticsBadgeText" Text="OCZEKIWANIE NA SKAN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="DiagnosticsSubtitleText" Text="Wyniki pojawią się po odczycie urządzeń. Brak problemów PnP nie potwierdza wszystkich parametrów sprzętu." FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />

                                            <ItemsControl x:Name="DiagnosticItemsControl">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="3" Margin="-4,0" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:DiagnosticItem}">
                                                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="*" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" Background="{Binding BadgeBackground}" CornerRadius="4" Padding="5,2" Margin="0,0,6,0" VerticalAlignment="Top">
                                                                        <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="Bold" Foreground="{Binding BadgeForeground}" />
                                                                    </Border>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" LineHeight="16" />
                                                                </Grid>
                                                                <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="16" />
                                                                <Grid Grid.Row="2">
                                                                    <Button Content="{Binding ActionButtonText}"
                                                                            Tag="{Binding ActionTarget}"
                                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                                            Padding="10,5" FontSize="11"
                                                                            Click="DiagnosticAction_Click"
                                                                            Visibility="{Binding HasButton, Converter={StaticResource BoolToVis}}" />
                                                                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="4" Padding="8,4"
                                                                            Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="{Binding NoteText}" FontSize="10.5" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                                                                    </Border>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="HardwareInventorySummaryText" Text="Poniżej pojawią się urządzenia zwrócone przez system Windows." Style="{StaticResource SubtitleStyle}" TextWrapping="Wrap" Margin="0,0,0,18"/>

                                    <!-- ==================== SEKCJA 3: ODCZYT WINDOWS PNP & STEROWNIKI ==================== -->
                                    <StackPanel Margin="0,0,0,18">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="Urządzenia i zainstalowane sterowniki" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="ODCZYT WINDOWS PNP" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="Brak odczytu urządzeń. Uruchom skan powyżej." Margin="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=PnpDevicesControl}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                <ItemsControl x:Name="PnpDevicesControl">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:PnpDeviceItem}">
                                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,12,12" Width="530" MinHeight="106">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <!-- Rząd 1: Ikona, Pełna Nazwa Urządzenia (z zawijaniem), Status Badge i Kategoria pionowo -->
                                                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Top">
                                                                    <TextBlock Text="{Binding CategoryIcon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,0,10,0">
                                                                    <TextBlock Text="{Binding DeviceName}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="18" />
                                                                    <TextBlock Text="{Binding Manufacturer}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                                                                    <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,3" Margin="0,0,0,4" HorizontalAlignment="Right">
                                                                        <TextBlock Text="{Binding UpdateStatusBadge}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                    </Border>
                                                                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                                                        <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- Rząd 2: Wersja sterownika -->
                                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="50,2,0,6">
                                                                <TextBlock Text="Sterownik:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding DriverVersion}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                            </StackPanel>

                                                            <!-- Rząd 3: Kanał aktualizacji i przycisk -->
                                                            <Grid Grid.Row="2" Margin="50,2,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                    <TextBlock Text="●" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" FontSize="11" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding UpdateMethod}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Content="{Binding ActionButtonText}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="11" Tag="{Binding ActionTarget}" Click="PnpDeviceAction_Click" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- SEKCJA 2: Certyfikowane Aktualizacje WHQL (Windows Update) -->
                                    <StackPanel>
                                        <TextBlock Text="CERTYFIKOWANE AKTUALIZACJE STEROWNIKÓW WHQL (WINDOWS UPDATE):" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,10" />

                                        <ItemsControl x:Name="DriverUpdatesControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type services:DriverUpdateItem}">
                                                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="6" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14,12" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding CategoryIcon}" FontSize="24" VerticalAlignment="Center" Margin="0,0,14,0" Width="32" TextAlignment="Center" />

                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                                        <TextBlock Text="{Binding Category}" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding ReleaseDate, StringFormat={}Data wydania: {0}}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="3" Text="{Binding Status}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- ==================== WIDOK 4: NARZĘDZIA & MAGAZYN (POŁĄCZONE BEZ DUPLIKATÓW) ==================== -->
                    <Grid x:Name="ViewTools" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,8,0">

                                <!-- Pasek nawigacyjny podnarzędzi Aetherial -->
                                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,6" Margin="0,0,0,14">
                                    <WrapPanel>
                                        <Button Content="🛠 Narzędzia zaawansowane" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Padding="12,6" FontSize="12" Click="NavToTools_Click" />
                                        <Button Content="🧹 Pamięci podręczne i śmieci" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,6" FontSize="12" Click="NavToCleaner_Click" />
                                        <Button Content="💾 Eksplorator woluminów" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,6" FontSize="12" Click="NavToExplorer_Click" />
                                        <Button Content="🔌 Sprzęt &amp; PnP" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,6" FontSize="12" Click="NavToDrivers_Click" />
                                        <Button Content="📦 Programy &amp; Winget" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" FontSize="12" Click="NavToApps_Click" />
                                    </WrapPanel>
                                </Border>

                                <!-- KARTA 1: ASYSTENT MIGRACJI DANYCH NA DYSK D/E (NTFS JUNCTION) -->
                                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="18" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🔗" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Przenoszenie folderów i dowiązania NTFS" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Kopiuje dane do wskazanej lokalizacji i zachowuje dostęp przez dowiązanie. Zamknij używające folderu programy. Kopia źródłowa pozostaje do czasu ręcznej weryfikacji." FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="34,0,0,14" TextWrapping="Wrap" LineHeight="19" />

                                        <ItemsControl x:Name="SymlinkPresetsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type services:SymlinkPreset}">
                                                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="6" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="130" />
                                                                <ColumnDefinition Width="130" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="24" VerticalAlignment="Center" Margin="0,0,14,0" Width="32" TextAlignment="Center" />

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                <TextBlock Text="{Binding SourcePath, StringFormat={}Źródło: {0}}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                                <TextBlock Text="{Binding SuggestedDestPath, StringFormat={}Cel: {0}}" FontSize="12" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0" />
                                                            <TextBlock Grid.Column="3" Text="{Binding Status}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0" />

                                                            <Button Grid.Column="4" Content="Przenieś i stwórz Symlink" Style="{StaticResource PrimaryButtonStyle}" FontSize="13" Padding="12,6" Tag="{Binding}" Click="ExecutePresetRelocation_Click" IsEnabled="{Binding CanRelocate}" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- KARTA 2: SPRZĄTACZ PROJEKTÓW DEWELOPERSKICH -->
                                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="18" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="💻" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Sprzątacz Zbędnych Pakietów Deweloperskich (node_modules, .venv, bin/obj)" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Wykrywa artefakty na podstawie plików projektu. Przejrzyj listę i zaznacz foldery, które można odtworzyć." FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="34,0,0,14" LineHeight="19" />

                                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="6" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="12,10" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <TextBlock Text="Folder projektów:" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBox x:Name="DevRootPathTextBox" Text="" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,5" FontSize="13" Width="260" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <TextBlock Text="Filtr nieaktywności:" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <ComboBox x:Name="DevInactiveComboBox" SelectedIndex="0" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="8,4" FontSize="13" VerticalAlignment="Center">
                                                        <ComboBoxItem Content="Wszystkie projekty" Tag="0" />
                                                        <ComboBoxItem Content="> 30 dni" Tag="30" />
                                                        <ComboBoxItem Content="> 60 dni" Tag="60" />
                                                        <ComboBoxItem Content="> 90 dni" Tag="90" />
                                                    </ComboBox>
                                                </StackPanel>

                                                <Button Grid.Column="2" Content="🔍 Skanuj pakiety" Style="{StaticResource PrimaryButtonStyle}" Click="ScanDevArtifacts_Click" Margin="0,0,10,0" />
                                                <Button Grid.Column="3" Content="🧹 Wyczyść zaznaczone pakiety" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Right" Click="CleanDevArtifacts_Click" />
                                            </Grid>
                                        </Border>

                                        <ItemsControl x:Name="DevArtifactsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type services:DevArtifactItem}">
                                                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="6" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,8" Padding="14,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="140" />
                                                                <ColumnDefinition Width="150" />
                                                            </Grid.ColumnDefinitions>

                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding TypeIcon}" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0" />

                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding ProjectName}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                                                        <TextBlock Text="{Binding ArtifactType}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding FullPath}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="3" Text="{Binding RelativeAgeText}" FontSize="13" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0" />
                                                            <TextBlock Grid.Column="4" Text="{Binding FormattedSize}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- KARTA 3: ZAAWANSOWANY TUNING SYSTEMU & DYSKÓW -->
                                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="18">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🛠️" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Zaawansowany Tuning Systemu (Hibernacja, VHDX, CompactOS)" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Hibernacja -->
                                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="6" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14,12" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="💤 Zarządzanie Plikiem Hibernacji (hiberfil.sys)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                        <Border x:Name="HibernationBadgeBorder" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock x:Name="HibernationStatusBadge" Text="OCZEKIWANIE NA ODCZYT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="Plik hibernacji znajduje się na dysku systemowym. Rozmiar i dostępność odczytasz w skanie czyszczenia." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Wyłącz hibernację" Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0" Click="DisableHibernation_Click" />
                                                    <Button Content="Tryb zredukowany" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="ReduceHibernation_Click" />
                                                    <Button Content="Włącz pełną" Style="{StaticResource SecondaryButtonStyle}" Click="EnableHibernation_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Kompaktowanie VHDX -->
                                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="6" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14,12" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="🐳 Kompaktowanie Dysków VHDX (Docker &amp; WSL)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="Obcina puste gigabajty z plików docker_data.vhdx oraz ext4.vhdx po usunięciu kontenerów." FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="📉 Kompaktuj Docker VHDX" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="ShrinkDockerVhdx_Click" />
                                            </Grid>
                                        </Border>

                                        <!-- CompactOS -->
                                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="6" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="🗜️ Bezstratna Kompresja NTFS (CompactOS / XPRESS8K)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="Kompresja NTFS zachowuje dostęp do plików. Efekt zależy od danych i nie jest gwarantowany." FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="🗜️ Wybierz folder do kompresji" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="CompactFolder_Click" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ==================== WIDOK 5: CENTRUM PROGRAMÓW & AKTUALIZATOR (100 APLIKACJI) ==================== -->
                    <Grid x:Name="ViewApps" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Pasek nagłówka i statusu folderu -->
                            <RowDefinition Height="Auto" /> <!-- Pasek filtrów, wyszukiwarki i akcji masowych -->
                            <RowDefinition Height="*" />    <!-- Lista 100 aplikacji -->
                        </Grid.RowDefinitions>

                        <!-- Pasek informacyjny i docelowy folder -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="16,12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="📥" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Centrum Oprogramowania &amp; Automatycznych Aktualizacji" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="WINGET NATIVE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Kompaktowy hub programistyczny, homelab, AI (ChatGPT, Antigravity) oraz narzędzia graficzne dla Windows 11. Cicha instalacja, brak adware, auto-aktualizacje winget." FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="📁 Domyślna ścieżka instalacji:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="AppsTargetFolderText" Text="Odczytywanie ustawień" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                        <Button Content="⚙️ Zmień w Ustawieniach" Style="{StaticResource SecondaryButtonStyle}" Padding="8,2" FontSize="11" Margin="12,0,0,0" Click="NavToSettings_Click" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="● ZAWSZE NAJNOWSZE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" />
                                    </Border>
                                    <Button Content="🔄 Sprawdź wersje" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="RefreshAppsStatus_Click" />
                                    <Button Content="⚡ ZAKTUALIZUJ WSZYSTKIE DO NAJNOWSZYCH" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="UpgradeAllInstalledApps_Click" ToolTip="Automatycznie pobiera i bezszelestnie aktualizuje wszystkie programy na komputerze do najnowszych wersji" />
                                    <Button Content="📥 Zainstaluj zaznaczone" Style="{StaticResource PrimaryButtonStyle}" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource CardBorderBrush}" Click="InstallSelectedApps_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Pasek wyszukiwania i kategorii -->
                        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="AppsSearchTextBox" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="10,6" FontSize="13" TextChanged="AppsSearchTextBox_TextChanged" VerticalAlignment="Center" ToolTip="Wpisz nazwę programu, technologię lub kategorię..." />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <Button Content="Zaznacz widoczne" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11" Margin="0,0,6,0" Click="SelectVisibleApps_Click" />
                                        <Button Content="Odznacz wszystkie" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11" Click="DeselectAllApps_Click" />
                                    </StackPanel>
                                </Grid>

                                <!-- Kafelki kategorii -->
                                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                    <Button Content="Wszystkie" Tag="All" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,6,4" FontSize="12" Click="FilterCategory_Click" />
                                    <Button Content="🖥️ Serwer Domowy &amp; Homelab" Tag="Serwer Domowy" Style="{StaticResource PrimaryButtonStyle}" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource CardBorderBrush}" Padding="10,4" Margin="0,0,6,4" FontSize="12" Click="FilterCategory_Click" />
                                    <Button Content="🤖 AI &amp; Antigravity" Tag="AI" Style="{StaticResource PrimaryButtonStyle}" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource CardBorderBrush}" Padding="10,4" Margin="0,0,6,4" FontSize="12" Click="FilterCategory_Click" />
                                    <Button Content="💻 Programowanie &amp; Dev" Tag="Programowanie" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,6,4" FontSize="12" Click="FilterCategory_Click" />
                                    <Button Content="🎨 Grafika &amp; Wideo" Tag="Grafika" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,6,4" FontSize="12" Click="FilterCategory_Click" />
                                    <Button Content="⚡ Narzędzia Systemu" Tag="Systemowe" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,6,4" FontSize="12" Click="FilterCategory_Click" />
                                    <Button Content="🌐 Przeglądarki" Tag="Przeglądarki" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,6,4" FontSize="12" Click="FilterCategory_Click" />
                                    <Button Content="💬 Komunikacja" Tag="Komunikacja" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,6,4" FontSize="12" Click="FilterCategory_Click" />
                                    <Button Content="🎮 Gry &amp; Rozrywka" Tag="Gry" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,6,4" FontSize="12" Click="FilterCategory_Click" />
                                    <Button Content="📄 Biuro &amp; Bezpieczeństwo" Tag="Biuro" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,6,4" FontSize="12" Click="FilterCategory_Click" />
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Lista aplikacji z wirtualizacją -->
                        <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="AppsItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:AppPackageItem}">
                                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="6" Width="480" MinHeight="110">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Rząd 1: CheckBox, Ikona, Nazwa, Kategoria -->
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="6" Width="36" Height="36" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Icon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="17" />
                                                            <TextBlock Text="{Binding Id}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                        </StackPanel>

                                                        <!-- Kategoria -->
                                                        <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        </Border>
                                                    </Grid>

                                                    <!-- Rząd 2: Opis -->
                                                    <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="46,6,0,8" MaxHeight="38" TextTrimming="CharacterEllipsis" />

                                                    <!-- Rząd 3: Status i Przycisk akcji -->
                                                    <Grid Grid.Row="2" Margin="46,0,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="●" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" FontSize="11" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="220" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="{Binding ActionButtonText}" IsEnabled="{Binding CanAction}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="11" Click="InstallSingleApp_Click" Tag="{Binding}" Visibility="{Binding ActionButtonVisible, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- ==================== WIDOK 6: USTAWIENIA SYSTEMU & MODUŁY ROZSZERZONE ==================== -->
                    <Grid x:Name="ViewSettings" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="6,0,10,0">
                                <!-- Nagłówek -->
                                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="18,14" Margin="0,0,0,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="⚙️" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Ustawienia Globalne &amp; Moduły Propozycji Rozwoju" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Zarządzaj domyślną lokalizacją instalacji programów, automatyzacją optymalizacji oraz uruchamiaj zaawansowane audyty gotowe pod obsługę klientów." FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- KARTA 1: Ścieżka instalacji aplikacji -->
                                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="📁 Domyślny Katalog Instalacji Aplikacji (Winget Custom Location)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                        <TextBlock Text="Wybrany folder jest przekazywany instalatorom, które obsługują własną lokalizację. Pakiety Microsoft Store i niektóre instalatory używają folderów systemowych." FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="SettingsInstallPathTextBox" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="12,8" FontSize="14" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="📂 Przeglądaj..." Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" VerticalAlignment="Center" Click="BrowseInstallFolder_Click" />
                                            <Button Grid.Column="2" Content="💾 Zapisz ustawienie" Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" VerticalAlignment="Center" Click="SaveInstallFolder_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- KARTA 2: Opcje automatyzacji -->
                                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="⚡ Opcje Automatyzacji i Bezpieczeństwa" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

                                        <CheckBox x:Name="OptSilentInstallCheck" Content="Cicha instalacja programów w tle (flagi --silent, brak uciążliwych instalatorów)" IsChecked="True" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" Click="SettingOption_Changed" />
                                        <CheckBox x:Name="OptAutoCheckUpdatesCheck" Content="Sprawdzaj dostępność aktualizacji oprogramowania winget w tle" IsChecked="True" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" Click="SettingOption_Changed" />
                                        <CheckBox x:Name="OptRecycleBinCheck" Content="Bezpieczne usuwanie: przenoś zbędne pliki do Kosza zamiast trwałego niszczenia" IsChecked="True" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Click="SettingOption_Changed" />
                                    </StackPanel>
                                </Border>

                                <!-- KARTA 3: 4 GOTOWE MODUŁY KLIENTSKIE & PROPOZYCJE ROZWOJU -->
                                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="💎" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Zaawansowane Moduły Diagnostyczne &amp; Narzędzia Klienckie" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="PRODUKCYJNE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Dedykowane narzędzia do profesjonalnej obsługi komputerów klientów, audytów wydajności i utwardzania Windows 11." FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

                                        <UniformGrid Columns="2">
                                            <!-- Moduł 1: Raport audytu -->
                                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,12">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Grid.Row="0">
                                                        <TextBlock Text="📑 Komercyjny Raport Audytowy (HTML/PDF)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock Text="Generuje estetyczny raport stanu PC klienta z marką procesora, pamięcią, stanem wolnego miejsca na dyskach i wyczyszczonymi śmieciami." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,12" />
                                                    </StackPanel>
                                                    <Button Grid.Row="2" Content="📑 Generuj Raport Klienta (HTML)" Style="{StaticResource PrimaryButtonStyle}" FontSize="13" Padding="12,7" Click="GenerateAuditReport_Click" />
                                                </Grid>
                                            </Border>

                                             <!-- Moduł 2: Tarcza Prywatności Windows 11 -->
                                             <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,12">
                                                 <Grid>
                                                     <Grid.RowDefinitions>
                                                         <RowDefinition Height="Auto" />
                                                         <RowDefinition Height="*" />
                                                         <RowDefinition Height="Auto" />
                                                     </Grid.RowDefinitions>
                                                     <StackPanel Grid.Row="0">
                                                         <Grid Margin="0,0,0,6">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="*" />
                                                                 <ColumnDefinition Width="Auto" />
                                                             </Grid.ColumnDefinitions>
                                                             <TextBlock Text="🛡️ Tarcza Prywatności Windows 11" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                             <Border x:Name="PrivacyShieldBadgeBorder" Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                 <TextBlock x:Name="PrivacyShieldStatusBadge" Text="OCZEKIWANIE NA ODCZYT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" />
                                                             </Border>
                                                         </Grid>
                                                         <TextBlock Text="Wyłącza telemetrię DiagTrack, śledzenie reklamowe Windows, zbędne usługi diagnostyczne i uwalnia dodatkowe zasoby procesora i dysku." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />
                                                     </StackPanel>
                                                     <Button x:Name="PrivacyShieldToggleButton" Grid.Row="2" Content="🛡️ Przełącz Tarczę Prywatności" Style="{StaticResource PrimaryButtonStyle}" Background="{DynamicResource AccentSoftBrush}" FontSize="13" Padding="12,7" Click="TogglePrivacyShield_Click" />
                                                 </Grid>
                                             </Border>

                                             <!-- Moduł 3: Czujnik Pamięci Windows (Storage Sense) -->
                                             <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                                                 <Grid>
                                                     <Grid.RowDefinitions>
                                                         <RowDefinition Height="Auto" />
                                                         <RowDefinition Height="*" />
                                                         <RowDefinition Height="Auto" />
                                                     </Grid.RowDefinitions>
                                                     <StackPanel Grid.Row="0">
                                                         <Grid Margin="0,0,0,6">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="*" />
                                                                 <ColumnDefinition Width="Auto" />
                                                             </Grid.ColumnDefinitions>
                                                             <TextBlock Text="🧹 Czujnik Pamięci (Storage Sense)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                             <Border x:Name="StorageSenseBadgeBorder" Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                 <TextBlock x:Name="StorageSenseStatusBadge" Text="OCZEKIWANIE NA ODCZYT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" />
                                                             </Border>
                                                         </Grid>
                                                         <TextBlock Text="Automatyczne oczyszczanie zbędnych plików tymczasowych i zawartości Kosza w tle Windows 11." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />
                                                     </StackPanel>
                                                     <Button x:Name="StorageSenseToggleButton" Grid.Row="2" Content="🧹 Przełącz Czujnik Pamięci" Style="{StaticResource SecondaryButtonStyle}" FontSize="13" Padding="12,7" Click="ToggleStorageSense_Click" />
                                                 </Grid>
                                             </Border>

                                            <!-- Moduł 4: Diagnostyka NVMe S.M.A.R.T. -->
                                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Grid.Row="0">
                                                        <TextBlock Text="🩺 Diagnostyka Zdrowia NVMe SSD (S.M.A.R.T.)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock Text="Odczytuje żywotność komórek pamięci, zużycie (Wear Leveling), temperaturę pracy kontrolera oraz liczbę zapisanych terabajtów (TBW)." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,12" />
                                                    </StackPanel>
                                                    <Button Grid.Row="2" Content="🩺 Sprawdź Kondycję NVMe" Style="{StaticResource SecondaryButtonStyle}" FontSize="13" Padding="12,7" Click="CheckNvmeHealth_Click" />
                                                </Grid>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ==================== WIDOK 7: KREATOR SKANOWANIA I WYNIKÓW (IObit Wizard) ==================== -->
                    <Grid x:Name="ViewScanner" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Pasek narzędziowy / filtr -->
                            <RowDefinition Height="*" />    <!-- Zawartość: Pasek postępu LUB Lista wyników -->
                        </Grid.RowDefinitions>

                        <!-- Nagłówek skanera -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="16,12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔍" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Centrum analizy i naprawy problemów" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock x:Name="ScannerResultsSummaryBadge" Text="Zainicjuj skanowanie, aby zbadać stan komputera." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="ScannerRestorePointCheck" Content="Utwórz punkt przywracania przed naprawą" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="12" />
                                    <Button x:Name="ScannerFixSelectedButton" Content="⚡  NAPRAW ZAZNACZONE" Style="{StaticResource SuccessButtonStyle}" Padding="20,8" FontSize="13" Click="FixSelected_Click" IsEnabled="False" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Obszar roboczy: Faza 1 (Skanowanie w toku) LUB Faza 2 (Lista wyników) -->
                        <Grid Grid.Row="1">
                            <!-- Faza 1: Panel aktywnego skanowania -->
                            <Border x:Name="ScannerProgressPanel" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="32" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600">
                                    <Border Width="80" Height="80" CornerRadius="40" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center" Margin="0,0,0,20">
                                        <TextBlock Text="⚡" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                    <TextBlock x:Name="ScannerCurrentStepText" Text="Trwa skanowanie komponentów systemu..." FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                    <TextBlock x:Name="ScannerDetailText" Text="Analizowanie lokalizacji tymczasowych, pamięci operacyjnej i urządzeń..." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,20" />
                                    
                                    <ProgressBar x:Name="ScannerProgressBar" Height="10" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,20" Foreground="{DynamicResource AccentBrush}" />
                                    
                                    <Button x:Name="ScannerCancelButton" Content="✕ Anuluj skanowanie" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Center" Padding="18,8" Click="CancelScan_Click" />
                                </StackPanel>
                            </Border>

                            <!-- Faza 2: Lista wyników z checkboxami -->
                            <Border x:Name="ScannerResultsPanel" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Visibility="Visible">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Pasek wyboru i filtrów -->
                                    <Border Grid.Row="0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                        <DockPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox x:Name="ScannerSelectAllCheckBox" Content="Zaznacz wszystkie elementy" IsChecked="True" VerticalAlignment="Center" Click="ScannerSelectAll_Click" Margin="0,0,16,0" />
                                                <TextBlock x:Name="ScannerSelectedCountText" Text="Zaznaczono: 0 pozycji" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Button Content="🔄 Uruchom ponowny skan" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="12,6" FontSize="12" Click="BigScanButton_Click" />
                                        </DockPanel>
                                    </Border>

                                    <!-- Lista pozycji ScanResultItem -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ScannerItemsControl" Margin="12">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:ScanResultItem}">
                                                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,8" Padding="16,12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Checkbox -->
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,16,0" />

                                                            <!-- Severity Badge -->
                                                            <Border Grid.Column="1" Background="{Binding SeverityBg}" CornerRadius="6" Padding="10,4" VerticalAlignment="Center" Margin="0,0,14,0">
                                                                <TextBlock Text="{Binding SeverityBadge}" FontSize="11" FontWeight="Bold" Foreground="{Binding SeverityColor}" />
                                                            </Border>

                                                            <!-- Tytuł, Kategoria, Opis -->
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                            </StackPanel>

                                                            <!-- Rozmiar do odzyskania i status -->
                                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="110" HorizontalAlignment="Right">
                                                                <TextBlock Text="{Binding FormattedSize}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                                                                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{Binding StatusColor}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ==================== WIDOK 8: HISTORIA I AUDYT OPERACJI ==================== -->
                    <Grid x:Name="ViewHistory" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Podsumowanie statystyk -->
                            <RowDefinition Height="*" />    <!-- Lista operacji -->
                        </Grid.RowDefinitions>

                        <!-- Podsumowanie statystyk -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Karta 1: Liczba wykonanych operacji -->
                            <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Margin="0,0,8,0" Padding="18,14">
                                <StackPanel>
                                    <TextBlock Text="ŁĄCZNIE OPERACJI" Style="{StaticResource EyebrowStyle}" />
                                    <TextBlock x:Name="HistoryTotalOpsText" Text="0" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0" />
                                    <TextBlock Text="Zarejestrowane procedury" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Karta 2: Łącznie zwolniona przestrzeń -->
                            <Border Grid.Column="1" Style="{StaticResource SurfaceCardStyle}" Margin="4,0,4,0" Padding="18,14">
                                <StackPanel>
                                    <TextBlock Text="ZWOLNIONA PRZESTRZEŃ" Style="{StaticResource EyebrowStyle}" />
                                    <TextBlock x:Name="HistoryTotalFreedText" Text="0 B" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,6,0,0" />
                                    <TextBlock Text="Odzyskane miejsce na dyskach" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Karta 3: Ostatnia optymalizacja -->
                            <Border Grid.Column="2" Style="{StaticResource SurfaceCardStyle}" Margin="8,0,0,0" Padding="18,14">
                                <StackPanel>
                                    <TextBlock Text="OSTATNIA OPTYMALIZACJA" Style="{StaticResource EyebrowStyle}" />
                                    <TextBlock x:Name="HistoryLastDateText" Text="Brak wpisów" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,0" />
                                    <TextBlock Text="Rejestr w %LocalAppData%\Aetherial" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Lista wpisów z historii -->
                        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Pasek akcji historii -->
                                <Border Grid.Row="0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📜" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Dziennik zdarzeń i rejestr zmian" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="🔄 Odśwież" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="10,5" FontSize="12" Click="RefreshHistory_Click" />
                                            <Button Content="📂 Otwórz folder" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="10,5" FontSize="12" Click="OpenHistoryFolder_Click" />
                                            <Button Content="🗑 Wyczyść historię" Style="{StaticResource DangerButtonStyle}" Padding="10,5" FontSize="12" Click="ClearHistory_Click" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Elementy historii -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="HistoryItemsControl" Margin="12">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:HistoryEntry}">
                                                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,8" Padding="16,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Status Badge -->
                                                        <Border Grid.Column="0" Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="10,4" VerticalAlignment="Center" Margin="0,0,16,0">
                                                            <TextBlock Text="{Binding StatusBadge}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusColor}" />
                                                        </Border>

                                                        <!-- Typ operacji & Czas -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0" MinWidth="160">
                                                            <TextBlock Text="{Binding OperationType}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding FormattedDate}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                        </StackPanel>

                                                        <!-- Podsumowanie / Szczegóły -->
                                                        <TextBlock Grid.Column="2" Text="{Binding Summary}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />

                                                        <!-- Zwolnione bajty -->
                                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="110">
                                                            <TextBlock Text="{Binding FormattedBytes}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" />
                                                            <TextBlock Text="{Binding ItemsFixed, StringFormat={}{0} naprawionych}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 3. PASEK PODSUMOWANIA & KONSOLA DZIENNIKA (LOG) -->
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Czysty, nienarzucający się pasek stanu na dole -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="GlobalStatusText" MaxWidth="470" TextTrimming="CharacterEllipsis" Text="Aetherial Suite • gotowy do działania" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ScanAllButton" Content="🔄 Odśwież stan systemu" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="ScanAllButton_Click" />
                            <Button x:Name="ToggleLogButton" Content="📋 Pokaż dziennik zdarzeń" Style="{StaticResource SecondaryButtonStyle}" Click="ToggleLogButton_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- Konsola logu zdarzeń -->
                    <Border Grid.Row="1" x:Name="LogDrawerBorder" Height="140" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,10,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="12,6,12,4">
                                <TextBlock Text="DZIENNIK ZDARZEŃ W CZASIE RZECZYWISTYM" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Button Content="Wyczyść log" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="8,3" FontSize="12" Click="ClearLog_Click" />
                            </Grid>
                            <TextBox Grid.Row="1" x:Name="LogTextBox" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas, monospace" FontSize="13" BorderThickness="0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="12,0,12,8" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ==================== NOWOCZESNE OKNO MODALNE (MODAL OVERLAY) ==================== -->
        <Grid x:Name="ModalOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="9999">
            <!-- Półprzezroczyste przyciemnione tło -->
            <Border Background="{DynamicResource CardBgBrush}" MouseDown="ModalBackdrop_MouseDown" />

            <!-- Nowoczesna karta modalna -->
            <Border Width="580"
                    MaxWidth="660"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="28,24">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="12" Opacity="0.85" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Nagłówek: Ikona + Tytuł -->
                        <RowDefinition Height="*" />    <!-- Treść komunikatu -->
                        <RowDefinition Height="Auto" /> <!-- Przyciski akcji -->
                    </Grid.RowDefinitions>

                    <!-- Nagłówek modala -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
                        <Border x:Name="ModalIconBorder" Background="{DynamicResource CardBgBrush}" CornerRadius="10" Width="52" Height="52" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ModalIconText" Text="❓" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ModalTitleText" Text="Tytuł komunikatu" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ModalCategoryText" Text="Aetherial Suite" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Treść wiadomości -->
                    <ScrollViewer Grid.Row="1" MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,0,0,26">
                        <TextBlock x:Name="ModalMessageText"
                                   Text="Treść komunikatu..."
                                   FontSize="15"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   LineHeight="24"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>

                    <!-- Przyciski akcji -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ModalCancelButton"
                                Content="Anuluj"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="20,10"
                                Margin="0,0,12,0"
                                Click="ModalCancel_Click" />
                        <Button x:Name="ModalConfirmButton"
                                Content="Potwierdź"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="24,10"
                                Click="ModalConfirm_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>

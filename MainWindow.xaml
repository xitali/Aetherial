                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- ==================== WIDOK 4: NARZĘDZIA & MAGAZYN (POŁĄCZONE BEZ DUPLIKATÓW) ==================== -->
                    <Grid x:Name="ViewTools" Visibility="Collapsed">
                      <StackPanel x:Name="ToolHomePanel">
                        <TextBlock Text="Narzędzia" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,8"/>

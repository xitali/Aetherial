<Window x:Class="DiskOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:DiskOptimizer.Models"
        xmlns:services="clr-namespace:DiskOptimizer.Services"
        mc:Ignorable="d"
        Title="AETHERIAL • STORAGE &amp; DIAGNOSTICS SUITE (Administrator)" 
        Icon="Assets/app_icon.png"
        Height="1000" Width="1600"
        MinHeight="820" MinWidth="1260"
        Background="#0B0C18"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        FontSize="15"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" 
                      ResizeBorderThickness="6" 
                      CornerRadius="0" 
                      GlassFrameThickness="0" 
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" /> <!-- Nowoczesny Cyber Pasek Tytułowy (Aetherial Header) -->
            <RowDefinition Height="*" />  <!-- Główny interfejs (Sidebar + Workspace) -->
        </Grid.RowDefinitions>

        <!-- ==================== NOWOCZESNY PASEK TYTUŁOWY AETHERIAL ==================== -->
        <Border Grid.Row="0" Background="#0A0B14" BorderBrush="#1C1B30" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Lewa strona: Nowe Logo AETHERIAL i podtytuł -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="30" Height="30" Background="#181530" BorderBrush="#8B5CF6" BorderThickness="1.5" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Image Source="Assets/app_icon.png" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="AETHERIAL" FontWeight="Black" FontSize="14" Foreground="#06B6D4" VerticalAlignment="Center" />
                            <TextBlock Text=" SUITE" FontWeight="Bold" FontSize="11" Foreground="#A78BFA" VerticalAlignment="Center" Margin="2,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="AERONAUTIC OPTIMIZATION &amp; DIAGNOSTIC SUITE" FontSize="7.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Środek: STORAGE & DIAGNOSTICS DASHBOARD + SYSTEM HEALTH + UPTIME + SECURITY -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="STORAGE &amp; DIAGNOSTICS DASHBOARD" FontWeight="ExtraBold" FontSize="12.5" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <TextBlock Text="SYSTEM HEALTH: " FontSize="9" FontWeight="SemiBold" Foreground="#64748B" />
                        <TextBlock Text="OPTIMAL" FontSize="9" FontWeight="Bold" Foreground="#10B981" Margin="0,0,14,0" />

                        <TextBlock Text="UPTIME: " FontSize="9" FontWeight="SemiBold" Foreground="#64748B" />
                        <TextBlock x:Name="TopUptimeText" Text="14D 03H" FontSize="9" FontWeight="Bold" Foreground="#06B6D4" Margin="0,0,14,0" />

                        <TextBlock Text="SECURITY: " FontSize="9" FontWeight="SemiBold" Foreground="#64748B" />
                        <TextBlock Text="PROTECTED (ACTIVE)" FontSize="9" FontWeight="Bold" Foreground="#10B981" />
                    </StackPanel>
                </StackPanel>

                <!-- Prawa strona: Ustawienia oraz Przyciski sterowania oknem (—, 🗖, Exit) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button Style="{StaticResource TitleBarButtonStyle}" 
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="NavToSettings_Click" 
                            ToolTip="Ustawienia Aetherial"
                            Width="40" Height="46">
                        <TextBlock Text="⚙" FontSize="15" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>

                    <Button x:Name="MinimizeButton" 
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MinimizeButton_Click" 
                            ToolTip="Minimalizuj"
                            Width="48" Height="42" 
                            Style="{StaticResource TitleBarButtonStyle}">
                        <TextBlock Text="—" FontSize="14" Foreground="#A0A0B0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>

                    <Button x:Name="MaximizeButton" 
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MaximizeButton_Click" 
                            ToolTip="Maksymalizuj / Przywróć"
                            Width="48" Height="42" 
                            Style="{StaticResource TitleBarButtonStyle}">
                        <TextBlock x:Name="MaximizeIconText" Text="🗖" FontSize="14" Foreground="#A0A0B0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>

                    <Button x:Name="CloseButton" 
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click" 
                            ToolTip="Zamknij program (Exit)"
                            Height="42" Padding="14,0"
                            Style="{StaticResource TitleBarCloseButtonStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Exit" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== GŁÓWNA ZAWARTOŚĆ OKNA ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" /> <!-- NOWY WĄSKI, ULTRA-COOL BOCZNY PASEK NAWIGACJI -->
                <ColumnDefinition Width="*" />  <!-- GŁÓWNY POWIĘKSZONY OBSZAR ROBOCZY -->
            </Grid.ColumnDefinitions>

            <!-- ==================== BOCZNY PASEK NAWIGACJI (COOL SLIM RAIL) ==================== -->
            <Border Grid.Column="0" Background="#111116" BorderBrush="#1C1C26" BorderThickness="0,0,1,0" Padding="0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Logo Badge -->
                        <RowDefinition Height="*" />    <!-- Przyciski nawigacyjne -->
                        <RowDefinition Height="Auto" /> <!-- Status Administratora -->
                    </Grid.RowDefinitions>

                    <!-- 1. Logo AETHERIAL z neonowym akcentem -->
                    <Border Grid.Row="0" Width="48" Height="48" Background="#16152C" BorderBrush="#8B5CF6" BorderThickness="1.5" CornerRadius="12" HorizontalAlignment="Center" Margin="0,0,0,16" ToolTip="Aetherial Systems Suite">
                        <Image Source="Assets/app_icon.png" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- 2. Menu Modułów (Smukłe przyciski Rail z ikonami i mikronapisami) -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                        <RadioButton x:Name="NavDashboardRadio" Style="{StaticResource NavRailButtonStyle}" Click="NavButton_Click" Tag="0" ToolTip="Pulpit — Centrum sterowania i automatyzacja 1-kliknięciem" IsChecked="True">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📊" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                <TextBlock Text="Pulpit" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavCleanerRadio" Style="{StaticResource NavRailButtonStyle}" Click="NavButton_Click" Tag="1" ToolTip="Śmieci — Pamięci podręczne, shadery GPU, kosz i temp">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🧹" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                <TextBlock Text="Śmieci" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavExplorerRadio" Style="{StaticResource NavRailButtonStyle}" Click="NavButton_Click" Tag="2" ToolTip="Dyski — Eksplorator partycji C, D, E, F, pliki giganty i tarcza Windows">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🧭" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                <TextBlock Text="Dyski" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavDriversRadio" Style="{StaticResource NavRailButtonStyle}" Click="NavButton_Click" Tag="3" ToolTip="Sprzęt — Specyfikacja PC i certyfikowane sterowniki WHQL">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🔌" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                <TextBlock Text="Sprzęt" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavToolsRadio" Style="{StaticResource NavRailButtonStyle}" Click="NavButton_Click" Tag="4" ToolTip="Narzędzia — Migracja na D/E, projekty Dev, VHDX i RAM">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                <TextBlock Text="Narzędzia" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavAppsRadio" Style="{StaticResource NavRailButtonStyle}" Click="NavButton_Click" Tag="5" ToolTip="Programy — Hub aplikacji (Dev, Homelab, AI, Grafika) i auto-aktualizacje winget">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📥" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                <TextBlock Text="Programy" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavSettingsRadio" Style="{StaticResource NavRailButtonStyle}" Click="NavButton_Click" Tag="6" ToolTip="Ustawienia — Domyślny folder instalacji, audyty i moduły zaawansowane">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⚙️" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                <TextBlock Text="Ustawienia" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- 3. Wskaźniki telemetryczne i status Administratora na dole (Styl ze zdjęcia nr 2) -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,8,0,2">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <TextBlock Text="📈" FontSize="13" Margin="2,0" ToolTip="Telemetria We/Wy SSD" />
                            <TextBlock Text="⚡" FontSize="13" Margin="2,0" ToolTip="Aktywność GPU" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Text="🛡️" FontSize="13" Margin="2,0" ToolTip="Tarcza Systemu Aktywna" />
                            <TextBlock Text="⚙️" FontSize="13" Margin="2,0" ToolTip="Diagnostyka" />
                        </StackPanel>
                        <Border Background="#142416" BorderBrush="#2E7D32" BorderThickness="1" CornerRadius="6" Width="48" Height="22" HorizontalAlignment="Center" ToolTip="Uruchomiono z pełnymi uprawnieniami Administratora Windows">
                            <TextBlock Text="ADMIN" FontSize="8.5" FontWeight="Bold" Foreground="#81C784" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== GŁÓWNY OBSZAR ROBOCZY (WORKSPACE) ==================== -->
            <Grid Grid.Column="1" Margin="22,16,22,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Dyski C, D, E, F -->
                    <RowDefinition Height="*" />    <!-- Przełączane widoki -->
                    <RowDefinition Height="Auto" /> <!-- Nowoczesny pasek stanu i log -->
                </Grid.RowDefinitions>

                <!-- 1. KARTY DYSKÓW (C, D, E, F) - W JEDNYM RZĘDZIE (1-ROW ULTRA-SLICK STATUS STRIP) -->
                <Border Grid.Row="0" Background="#13131A" CornerRadius="8" BorderBrush="#20202C" BorderThickness="1" Padding="12,8" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Etykieta NVMe SSD -->
                        <Border Grid.Column="0" Background="#1A1A26" CornerRadius="6" BorderBrush="#2A2A3A" BorderThickness="1" Padding="10,5" Margin="0,0,10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Kingston KC3000 NVMe PCIe 4.0" FontWeight="Bold" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- 4 Partycje w 1 równym rzędzie -->
                        <ItemsControl Grid.Column="1" x:Name="DrivesItemsControl" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DriveModel}">
                                    <Border Background="#181824" CornerRadius="6" BorderBrush="#262634" BorderThickness="1" Padding="10,6" Margin="4,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Nazwa dysku -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="💾" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Pasek zużycia -->
                                            <ProgressBar Grid.Column="1" Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,0,8,0" Foreground="{Binding StatusColor}" Background="#0E0E12" VerticalAlignment="Center" />

                                            <!-- Wolne miejsce -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FormattedFree}" FontWeight="Bold" FontSize="12" Foreground="{Binding StatusColor}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding FormattedTotal, StringFormat={} / {0}}" FontSize="11" Foreground="#7A7A88" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Podsumowanie Łączne Wolne Miejsce & Przycisk Pełnego Skanowania -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Border Background="#162334" BorderBrush="#0078D4" BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📊" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="DrivesSummaryText" Text="Łącznie: 1.26 TB wolne" FontSize="12" FontWeight="Bold" Foreground="#64B5F6" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Button x:Name="MasterScanButton" Content="⚡ Pełne Skanowanie" Style="{StaticResource PrimaryButtonStyle}" Padding="14,6" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" Click="MasterScanAll_Click" ToolTip="Jednym kliknięciem odświeża stan wszystkich partycji, bada zużycie RAM oraz skanuje wszystkie pamięci podręczne i śmieci" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. PRZEŁĄCZANE WIDOKI MODUŁÓW -->
                <Grid Grid.Row="1">

                    <!-- ==================== WIDOK 0: AETHERIAL CYBER-NEON DASHBOARD (STYL ZE ZDJĘCIA NR 2) ==================== -->
                    <Grid x:Name="ViewDashboard" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" MinHeight="360" /> <!-- GÓRNY RZĄD: SSD STORAGE OPTIMIZATION & DISK HEALTH -->
                            <RowDefinition Height="2*" MinHeight="250" /> <!-- DOLNY RZĄD: LIVE METRICS, DIAGNOSTICS & THROUGHPUT -->
                        </Grid.RowDefinitions>

                        <!-- ==================== GÓRNY RZĄD: SSD STORAGE OPTIMIZATION & DISK HEALTH & DEFRAG ==================== -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65*" /> <!-- SSD STORAGE OPTIMIZATION (Słupki 3D & 94% OPTIMIZED) -->
                                <ColumnDefinition Width="35*" /> <!-- DISK HEALTH & DEFRAG (Radial 98% Gauge) -->
                            </Grid.ColumnDefinitions>

                            <!-- KARTA 1: SSD STORAGE OPTIMIZATION -->
                            <Border x:Name="Dash1ClickCardBorder" Grid.Column="0" Background="#0F1022" CornerRadius="12" BorderBrush="#252445" BorderThickness="1.5" Padding="20,16" Margin="0,0,12,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /> <!-- Nagłówek -->
                                        <RowDefinition Height="*" />    <!-- Wizualizacja 3D i statystyki -->
                                        <RowDefinition Height="Auto" /> <!-- Pasek akcji 1-Klik i stan cache -->
                                    </Grid.RowDefinitions>

                                    <!-- Nagłówek Widgetu -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="SSD STORAGE OPTIMIZATION" FontSize="13" FontWeight="Black" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                            <Border x:Name="Dash1ClickBadge" Background="#1E1B4B" BorderBrush="#8B5CF6" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="Dash1ClickBadgeText" Text="ZALECANE" FontSize="10" FontWeight="Bold" Foreground="#A78BFA" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource TitleBarButtonStyle}" Width="24" Height="24" Padding="0" Margin="0,0,4,0">
                                                <TextBlock Text="‹" FontSize="15" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Button>
                                            <Button Style="{StaticResource TitleBarButtonStyle}" Width="24" Height="24" Padding="0">
                                                <TextBlock Text="›" FontSize="15" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Środek: SSD Icon + 3D Isometric Bar Columns + 94% OPTIMIZED Display -->
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" /> <!-- SSD Icon & Luminous Bus Line -->
                                            <ColumnDefinition Width="*" />    <!-- 3D Isometric Bars -->
                                            <ColumnDefinition Width="Auto" /> <!-- 94% OPTIMIZED Display -->
                                        </Grid.ColumnDefinitions>

                                        <!-- SSD Icon z neonową linią magistrali pamięci (Styl ze zdjęcia nr 2) -->
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,22,0">
                                            <Border Width="62" Height="62" Background="#181530" BorderBrush="#A855F7" BorderThickness="2" CornerRadius="12">
                                                <Grid>
                                                    <Rectangle Stroke="#C084FC" StrokeThickness="1" Margin="4" RadiusX="8" RadiusY="8" StrokeDashArray="2 2" />
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="💾" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                                        <TextBlock Text="SSD" FontSize="11" FontWeight="Black" Foreground="#E2E8F0" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <!-- Świecąca magistrala danych -->
                                            <Rectangle Width="2" Height="30" Fill="#06B6D4" Margin="0,4,0,4" />
                                            <!-- Warstwy NAND flash -->
                                            <Canvas Width="44" Height="24">
                                                <Polygon Points="22,2 42,10 22,18 2,10" Fill="#1E1945" Stroke="#06B6D4" StrokeThickness="1.5" />
                                                <Polygon Points="22,6 42,14 22,22 2,14" Fill="#141230" Stroke="#8B5CF6" StrokeThickness="1.5" />
                                            </Canvas>
                                        </StackPanel>

                                        <!-- 4 Słupki 3D dla dysków z izometrycznymi podstawami -->
                                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="10,0,10,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Słupki gradientowe 3D -->
                                            <Grid Grid.Row="1" Height="130" Margin="0,6,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Słupek 1: Drive C (System) - Gradient Magenta/Purple -->
                                                <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Polygon Points="20,0 40,7 20,14 0,7" Fill="#F472B6" />
                                                        <Border Width="40" Height="90" CornerRadius="0,0,4,4">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#EC4899" Offset="0" />
                                                                    <GradientStop Color="#8B5CF6" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Słupek 2: Drive D NVMe - Gradient Violet/Cyan -->
                                                <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Polygon Points="20,0 40,7 20,14 0,7" Fill="#C084FC" />
                                                        <Border Width="40" Height="110" CornerRadius="0,0,4,4">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#8B5CF6" Offset="0" />
                                                                    <GradientStop Color="#06B6D4" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Słupek 3: Drive E (Data) - Gradient Blue/Cyan -->
                                                <Grid Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Polygon Points="20,0 40,7 20,14 0,7" Fill="#38BDF8" />
                                                        <Border Width="40" Height="75" CornerRadius="0,0,4,4">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#0284C7" Offset="0" />
                                                                    <GradientStop Color="#06B6D4" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Słupek 4: Drive F NVMe - Gradient Cyan/Green -->
                                                <Grid Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Polygon Points="20,0 40,7 20,14 0,7" Fill="#67E8F9" />
                                                        <Border Width="40" Height="125" CornerRadius="0,0,4,4">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#06B6D4" Offset="0" />
                                                                    <GradientStop Color="#10B981" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>

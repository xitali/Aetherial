<Window x:Class="DiskOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:views="clr-namespace:DiskOptimizer.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:DiskOptimizer.Models;assembly=Aetherial.Core"
        xmlns:services="clr-namespace:DiskOptimizer.Services;assembly=Aetherial.Services"
        mc:Ignorable="d"
        Title="Aetherial"
        Icon="Assets/app_icon.png"
        Height="820" Width="1280"
        MinHeight="760" MinWidth="1180"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        FontSize="15"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource BgDarkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" /> <!-- Nowoczesny Cyber Pasek Tytułowy (Aetherial Header) -->
            <RowDefinition Height="*" />  <!-- Główny interfejs (Sidebar + Workspace) -->
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="MinimizeButton" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Width="46" Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Minimalizuj"/>
              <Button x:Name="MaximizeButton" Width="46" Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeButton_Click" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Maksymalizuj lub przywróć"><TextBlock x:Name="MaximizeIconText" Text="&#xE922;" FontFamily="Segoe MDL2 Assets"/></Button>
              <Button x:Name="CloseButton" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Width="46" Style="{StaticResource TitleBarCloseButtonStyle}" Click="CloseButton_Click" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Zamknij"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center"><Image Source="Assets/app_icon.png" Width="23" Height="23" Margin="0,0,10,0"/><TextBlock Text="Aetherial" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="TopUptimeText" Visibility="Collapsed"/></StackPanel>
          </DockPanel>
        </Border>
        <!-- ==================== GŁÓWNA ZAWARTOŚĆ OKNA ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="184" /> <!-- SIDEBAR (IObit Style) -->
                <ColumnDefinition Width="*" />   <!-- GŁÓWNY OBSZAR ROBOCZY -->
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0" Padding="12,24,12,16">
              <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                  <RadioButton x:Name="NavHistoryRadio" GroupName="MainNavigation" Tag="8" Style="{StaticResource NavSidebarButtonStyle}" Click="NavButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="28" VerticalAlignment="Center"/><TextBlock Text="Historia" VerticalAlignment="Center"/></StackPanel></RadioButton>
                  <RadioButton x:Name="NavSettingsRadio" GroupName="MainNavigation" Tag="6" Style="{StaticResource NavSidebarButtonStyle}" Click="NavButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="28" VerticalAlignment="Center"/><TextBlock Text="Ustawienia" VerticalAlignment="Center"/></StackPanel></RadioButton>
                </StackPanel>
                <StackPanel>
                  <RadioButton x:Name="NavCleanerRadio" GroupName="MainNavigation" Tag="1" IsChecked="True" Style="{StaticResource NavSidebarButtonStyle}" Click="NavButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE75C;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="28" VerticalAlignment="Center"/><TextBlock Text="Czyść" VerticalAlignment="Center"/></StackPanel></RadioButton>
                  <RadioButton x:Name="NavExplorerRadio" GroupName="MainNavigation" Tag="2" Style="{StaticResource NavSidebarButtonStyle}" Click="NavButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="28" VerticalAlignment="Center"/><TextBlock Text="Dyski" VerticalAlignment="Center"/></StackPanel></RadioButton>
                  <RadioButton x:Name="NavDriversRadio" GroupName="MainNavigation" Tag="3" Style="{StaticResource NavSidebarButtonStyle}" Click="NavButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="28" VerticalAlignment="Center"/><TextBlock Text="Sterowniki" VerticalAlignment="Center"/></StackPanel></RadioButton>
                  <RadioButton x:Name="NavAppsRadio" GroupName="MainNavigation" Tag="5" Style="{StaticResource NavSidebarButtonStyle}" Click="NavButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="28" VerticalAlignment="Center"/><TextBlock Text="Programy" VerticalAlignment="Center"/></StackPanel></RadioButton>
                  <RadioButton x:Name="NavToolsRadio" GroupName="MainNavigation" Tag="4" Style="{StaticResource NavSidebarButtonStyle}" Click="NavButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="28" VerticalAlignment="Center"/><TextBlock Text="Narzędzia" VerticalAlignment="Center"/></StackPanel></RadioButton>
                  <RadioButton x:Name="NavDashboardRadio" Visibility="Collapsed"/><RadioButton x:Name="NavScannerRadio" Visibility="Collapsed"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <!-- ==================== GŁÓWNY OBSZAR ROBOCZY (WORKSPACE) ==================== -->
            <Grid Grid.Column="1" Margin="22,16,22,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Dyski C, D, E, F -->
                    <RowDefinition Height="Auto" /> <!-- Tematy narzędzi -->
                    <RowDefinition Height="*" />    <!-- Przełączane widoki -->
                    <RowDefinition Height="Auto" /> <!-- Nowoczesny pasek stanu i log -->
                </Grid.RowDefinitions>

                <!-- 1. KARTY DYSKÓW (C, D, E, F) - W JEDNYM RZĘDZIE (1-ROW ULTRA-SLICK STATUS STRIP) -->
                <Border x:Name="LegacyStatusHeader" Visibility="Collapsed" Grid.Row="0" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="12,8" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Etykieta NVMe SSD -->
                        <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" CornerRadius="6" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="10,5" Margin="0,0,10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="CurrentSectionText" Text="PULPIT" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- 4 Partycje w 1 równym rzędzie -->
                        <ItemsControl Grid.Column="1" x:Name="DrivesItemsControl" VerticalAlignment="Center" Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DriveModel}">
                                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="6" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="10,6" Margin="4,3" MinWidth="190">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Nazwa dysku -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="💾" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Pasek zużycia -->
                                            <ProgressBar Grid.Column="1" Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}" Background="{DynamicResource CardBgBrush}" VerticalAlignment="Center" />

                                            <!-- Wolne miejsce -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FormattedFree}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding FormattedTotal, StringFormat={} / {0}}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Podsumowanie Łączne Wolne Miejsce & Przycisk Pełnego Skanowania -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📊" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="DrivesSummaryText" Text="Odczyt wolnego miejsca…" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Button x:Name="MasterScanButton" Content="⚡ Pełne Skanowanie" Style="{StaticResource PrimaryButtonStyle}" Padding="14,6" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" Click="MasterScanAll_Click" ToolTip="Jednym kliknięciem odświeża stan wszystkich partycji, bada zużycie RAM oraz skanuje wszystkie pamięci podręczne i śmieci" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. PRZEŁĄCZANE WIDOKI MODUŁÓW -->
                <Grid Grid.Row="2">

                    <!-- ==================== WIDOK 0: GŁÓWNA (IObit Dashboard: Circular Gauge + Big CTA + 4 Moduły) ==================== -->
                    <Grid x:Name="ViewDashboard" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,12,16">
                                <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,0,16" Padding="24">
                                  <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid Width="140" Height="140" HorizontalAlignment="Left">
                                      <Ellipse Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="7"/>
                                      <Ellipse x:Name="HealthRingEllipse" Stroke="{DynamicResource AccentBrush}" StrokeThickness="7"/>
                                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock x:Name="HealthScoreText" Text="—" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/><TextBlock Text="WYNIK SKANU" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,22,0">
                                      <TextBlock Text="Twój komputer. Czytelny stan." FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                      <TextBlock x:Name="HealthStatusLabel" Text="OCZEKUJE NA SKAN" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,12,0,4" TextWrapping="Wrap"/>
                                      <TextBlock x:Name="HealthIssuesCountText" Text="Odczyty sprzętu i miejsca są aktualizowane automatycznie." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                      <TextBlock x:Name="DashboardHealthText" Text="Przejrzyj wyniki przed wprowadzeniem zmian." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" x:Name="DashboardScanBigButton" Content="Skanuj komputer →" Style="{StaticResource PrimaryButtonStyle}" Padding="22,14" VerticalAlignment="Center" Click="BigScanButton_Click"/>
                                  </Grid>
                                </Border>
                                <!-- 4 KARTY PODSUMOWUJĄCE MODUŁY (W JEDNYM RZĘDZIE) -->
                                <UniformGrid Columns="4" Margin="0,0,0,18">
                                    <!-- Karta 1: Pamięć podręczna i śmieci -->
                                    <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,8,0" Padding="16,14">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="🧹" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="CACHE &amp; PLIKI" Style="{StaticResource EyebrowStyle}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock x:Name="DashCacheText" Text="Nie zeskanowano" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,2" />
                                                <TextBlock x:Name="DashShadersText" Text="Shadery GPU: gotowe" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Row="2" Content="Szczegóły czyszczenia ➔" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="11" Margin="0,10,0,0" Click="NavToCleaner_Click" />
                                        </Grid>
                                    </Border>

                                    <!-- Karta 2: Pamięć RAM -->
                                    <Border Style="{StaticResource SurfaceCardStyle}" Margin="4,0,4,0" Padding="16,14">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="⚡" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="PAMIĘĆ RAM" Style="{StaticResource EyebrowStyle}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock x:Name="RamStatusText" Text="Oczekiwanie na odczyt" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,2" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="Odczyt pamięci z Windows" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <Button Grid.Row="2" Content="Optymalizuj RAM ➔" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="11" Margin="0,10,0,0" Click="OptimizeRamNow_Click" />
                                        </Grid>
                                    </Border>

                                    <!-- Karta 3: Sprzęt & Urządzenia PnP -->
                                    <Border Style="{StaticResource SurfaceCardStyle}" Margin="4,0,4,0" Padding="16,14">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="🔌" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="SPRZĘT &amp; MAGISTRALA" Style="{StaticResource EyebrowStyle}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock x:Name="DashboardCpuText" Text="Oczekiwanie na odczyt" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                                                <TextBlock x:Name="DashboardGpuText" Text="Oczekiwanie na odczyt" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Row="2" Content="Zarządzaj sprzętem ➔" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="11" Margin="0,10,0,0" Click="NavToDrivers_Click" />
                                        </Grid>
                                    </Border>

                                    <!-- Karta 4: Woluminy & Sieć -->
                                    <Border Style="{StaticResource SurfaceCardStyle}" Margin="8,0,0,0" Padding="16,14">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="🌐" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="SIEĆ &amp; PAMIĘĆ MASOWA" Style="{StaticResource EyebrowStyle}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock x:Name="DashboardNetworkText" Text="Oczekiwanie na odczyt" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                                                <TextBlock x:Name="DashboardSecurityText" Text="Stan ochrony: brak odczytu" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Row="2" Content="Eksploruj dyski ➔" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="11" Margin="0,10,0,0" Click="NavToExplorer_Click" />
                                        </Grid>
                                    </Border>
                                </UniformGrid>

                                <!-- Sekcja Partycji Dyskowych -->
                                <TextBlock Text="Przestrzeń dyskowa woluminów" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6"/>
                                <TextBlock Text="Rzeczywiste zużycie wykrytych woluminów fizycznych w systemie Windows." Style="{StaticResource SubtitleStyle}" Margin="0,0,0,14"/>
                                <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=DrivesItemsControl}" Margin="-5,0,-5,16">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Border Style="{StaticResource SurfaceCardStyle}" Padding="18,14" Margin="5">
                                            <StackPanel>
                                                <DockPanel><TextBlock Text="{Binding UsedPercent, StringFormat={}{0:0.#}% zajęte}" DockPanel.Dock="Right" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/></DockPanel>
                                                <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Foreground="{DynamicResource TextSecondaryBrush}" Height="6" Margin="0,12,0,10"/>
                                                <DockPanel><TextBlock Text="{Binding FormattedTotal, StringFormat={}Pojemność: {0}}" DockPanel.Dock="Right" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding FormattedFree, StringFormat={}Wolne: {0}}" FontWeight="SemiBold"/></DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Kompatybilność: Złożone kontrolki zachowane dla stabilności -->
                                <Border x:Name="Dash1ClickCardBorder" Visibility="Collapsed">
                                    <StackPanel>
                                        <Border x:Name="Dash1ClickBadge"><TextBlock x:Name="Dash1ClickBadgeText" Text="" /></Border>
                                        <Button x:Name="Dash1ClickButton" Click="AutoOptimize1Click_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Czyszczenie: zakres i wyniki skanowania -->
                    <Grid x:Name="ViewCleaner" Visibility="Visible"><views:CleanerView x:Name="CleanerPanel"/></Grid>
<!-- ==================== WIDOK 2: EKSPLORATOR PARTYCJII (DYSKI & GIGANTY) ==================== -->
                    <Grid x:Name="ViewExplorer" Visibility="Collapsed">
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <DockPanel Margin="0,4,0,22"><Button x:Name="LargeFilesButton" DockPanel.Dock="Right" Content="Znajdź duże pliki" Style="{StaticResource PrimaryButtonStyle}" Click="FindLargeFiles_Click" VerticalAlignment="Center"/><StackPanel><TextBlock Text="Dyski" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Sprawdź, co zajmuje miejsce." Style="{StaticResource SubtitleStyle}"/></StackPanel></DockPanel>
                      <ItemsControl Grid.Row="1" ItemsSource="{Binding ItemsSource, ElementName=DrivesItemsControl}" Margin="0,0,0,16">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding RootPath}" Style="{StaticResource SecondaryButtonStyle}" Padding="16,12" Margin="0,0,10,8" Width="210" HorizontalContentAlignment="Stretch" Click="SwitchPartition_Click"><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/><ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,10,0,8"/><TextBlock Text="{Binding FormattedFree, StringFormat={}Wolne: {0}}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <StackPanel Grid.Row="2">
                        <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Left" Content="W górę" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="NavigateUp_Click"/><Button DockPanel.Dock="Right" Content="Przejdź" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="NavigatePath_Click"/><TextBox x:Name="CurrentPathTextBox" KeyDown="CurrentPathTextBox_KeyDown" AutomationProperties.Name="Ścieżka folderu"/></DockPanel>
                        <Expander Header="Opcje zaznaczania" Margin="0,0,0,10" Foreground="{DynamicResource TextSecondaryBrush}"><WrapPanel Margin="0,10,0,0"><Button Content="Wszystkie" Tag="0" Click="SelectByAge_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Starsze niż 30 dni" Tag="30" Click="SelectByAge_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Starsze niż rok" Tag="365" Click="SelectByAge_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Odznacz" Click="DeselectExplorer_Click" Style="{StaticResource SecondaryButtonStyle}"/></WrapPanel></Expander>
                      </StackPanel>
                      <Grid Grid.Row="3">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="ExplorerItemsControl"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type models:FileSystemItem}">
                          <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="10,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanDelete}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}"/>
                            <StackPanel Grid.Column="1" Margin="8,0,16,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/><TextBlock Text="{Binding ParentDirectory}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0" ToolTip="{Binding FormattedDate}"/>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Otwórz" Tag="{Binding Path}" Click="EnterFolder_Click" Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" Margin="0,0,6,0"/><Button Content="⋯" Tag="{Binding Path}" Click="OpenExplorerPath_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" ToolTip="Pokaż w Eksploratorze Windows" AutomationProperties.Name="Pokaż w Eksploratorze Windows"/></StackPanel>
                          </Grid></Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                        <Border x:Name="ExplorerSelectionBar" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource SurfaceCardStyle}" Padding="14" Margin="0,12,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="Usuń zaznaczone" Click="DeleteSelectedExplorerFiles_Click" Style="{StaticResource DangerButtonStyle}"/><StackPanel VerticalAlignment="Center"><TextBlock x:Name="ExplorerSelectedSummaryText" FontWeight="SemiBold"/><CheckBox x:Name="RecycleBinCheckBox" Content="Przenieś do Kosza" IsChecked="True" Margin="0,6,0,0"/></StackPanel></DockPanel></Border>

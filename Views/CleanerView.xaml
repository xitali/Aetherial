<UserControl x:Class="DiskOptimizer.Views.CleanerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:models="clr-namespace:DiskOptimizer.Models;assembly=Aetherial.Core"
 xmlns:local="clr-namespace:DiskOptimizer.Views">
 <UserControl.Resources>
  <local:CleanItemWarningConverter x:Key="CleanItemWarning"/>
  <local:CleanItemTitleConverter x:Key="CleanItemTitle"/>
 </UserControl.Resources>
 <Grid>
  <!-- Only the current step is visible; no unscanned categories or inactive actions. -->
  <StackPanel x:Name="IdlePanel" MaxWidth="580" VerticalAlignment="Center" HorizontalAlignment="Center"
              Visibility="{Binding ShowIdle, Converter={StaticResource BoolToVis}}" Margin="24,0,24,70">
   <Border Width="72" Height="72" CornerRadius="22" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center" Margin="0,0,0,24">
    <TextBlock Text="&#xE75C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="30" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border>
   <TextBlock Text="Zwolnij miejsce" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="34" FontWeight="SemiBold" TextAlignment="Center"/>
   <TextBlock Text="{Binding IdleDescription}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,28"/>
   <Button x:Name="StartScanButton" Content="Skanuj" Style="{StaticResource PrimaryButtonStyle}" Click="Scan_Click" FontSize="16" MinWidth="190" Padding="30,15" HorizontalAlignment="Center"/>
  </StackPanel>

  <StackPanel x:Name="BusyPanel" Width="500" MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Center"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="24,0,24,70">
   <TextBlock Text="{Binding Heading}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="30" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,24"/>
   <ProgressBar Height="6" Value="{Binding Progress, Mode=OneWay}" Maximum="100" IsIndeterminate="{Binding IsCleaning}" Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="Postęp operacji"/>
   <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Margin="0,12,0,24"/>
   <Button Content="Anuluj" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" HorizontalAlignment="Center" MinWidth="120"/>
  </StackPanel>

  <Grid x:Name="ResultsPanel" Visibility="{Binding ShowResults, Converter={StaticResource BoolToVis}}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Style="{StaticResource SurfaceCardStyle}" Padding="28" Margin="0,0,0,18">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,24,0">
      <TextBlock Text="{Binding ResultsHeading}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding FoundSize}" FontSize="40" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,8"/>
      <TextBlock x:Name="SelectedSummary" Text="{Binding SelectionText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
     </StackPanel>
     <StackPanel Grid.Column="1" VerticalAlignment="Center">
      <Button x:Name="ReviewCleanButton" Content="Przejrzyj i wyczyść" Style="{StaticResource PrimaryButtonStyle}" Padding="24,14" FontSize="15" IsEnabled="{Binding CanClean}" Click="Clean_Click" Visibility="{Binding HasCleanableData, Converter={StaticResource BoolToVis}}"/>
      <Button Content="Skanuj ponownie" Style="{StaticResource SecondaryButtonStyle}" Click="Scan_Click" Margin="0,8,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
   <DockPanel Grid.Row="1" Margin="4,0,4,12">
    <Button DockPanel.Dock="Right" Content="Odznacz wszystko" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Click="Deselect_Click"/>
    <CheckBox Content="Pokaż też puste kategorie" IsChecked="{Binding ShowAllCategories}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
   </DockPanel>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <ItemsControl x:Name="ResultsList" ItemsSource="{Binding ItemsView}" IsEnabled="{Binding CanSelect}">
      <ItemsControl.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate>
       <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,12,0,8"/>
      </DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ItemsControl.GroupStyle>
      <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type models:CleanItem}">
       <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,0,6">
        <Grid>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,14,0" AutomationProperties.Name="{Binding Title}">
          <CheckBox.Style>
           <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="IsEnabled" Value="False"/>
            <Style.Triggers>
             <MultiDataTrigger>
              <MultiDataTrigger.Conditions><Condition Binding="{Binding CanClean}" Value="True"/><Condition Binding="{Binding IsScanned}" Value="True"/></MultiDataTrigger.Conditions>
              <Setter Property="IsEnabled" Value="True"/>
             </MultiDataTrigger>
             <DataTrigger Binding="{Binding SizeBytes}" Value="0"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
            </Style.Triggers>
           </Style>
          </CheckBox.Style>
         </CheckBox>
         <TextBlock Grid.Column="1" Text="{Binding Converter={StaticResource CleanItemTitle}}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,18,0"/>
         <TextBlock Grid.Column="2" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="95" TextAlignment="Right" Margin="0,0,18,0">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding FormattedSize}"/><Style.Triggers><DataTrigger Binding="{Binding IsScanned}" Value="False"><Setter Property="Text" Value="Nie odczytano"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
         </TextBlock>
         <ToggleButton x:Name="DetailsToggle" Grid.Column="3" Content="Szczegóły" Padding="10,7" FontSize="12" Cursor="Hand" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" AutomationProperties.Name="{Binding Title, StringFormat=Szczegóły: {0}}">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ToggleFrame" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleFrame" Property="Background" Value="{DynamicResource CardHoverBgBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToggleFrame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="ToggleFrame" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
         </ToggleButton>
         <TextBlock x:Name="SelectedWarning" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,2" Text="{Binding Converter={StaticResource CleanItemWarning}}" Foreground="{DynamicResource WarningBrush}" FontSize="12" TextWrapping="Wrap">
          <TextBlock.Style>
           <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
             <DataTrigger Binding="{Binding Converter={StaticResource CleanItemWarning}}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
           </Style>
          </TextBlock.Style>
         </TextBlock>
         <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,12,0,4" Visibility="{Binding IsChecked, ElementName=DetailsToggle, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Path}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
          <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
         </StackPanel>
        </Grid>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock Text="{Binding ScanSummary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="4,14,0,8"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>

  <StackPanel x:Name="OutcomePanel" MaxWidth="580" VerticalAlignment="Center" HorizontalAlignment="Center"
              Visibility="{Binding ShowOutcome, Converter={StaticResource BoolToVis}}" Margin="24,0,24,70">
   <TextBlock Text="{Binding Heading}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="30" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding OutcomeSize}" Foreground="{DynamicResource AccentBrush}" FontSize="44" FontWeight="SemiBold" TextAlignment="Center" Margin="0,18,0,4"/>
   <TextBlock Text="zwolnionego miejsca" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Margin="0,0,0,20"/>
   <TextBlock Text="{Binding ResultText}" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24"/>
   <Button Content="Skanuj ponownie" Style="{StaticResource PrimaryButtonStyle}" Click="Scan_Click" MinWidth="190" Padding="24,14" HorizontalAlignment="Center"/>
  </StackPanel>
 </Grid>
</UserControl>

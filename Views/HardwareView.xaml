<UserControl x:Class="DiskOptimizer.Views.HardwareView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="DriverFilterStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="12,8"/>
   <Setter Property="Margin" Value="0,0,4,0"/>
   <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  </Style>
  <Style x:Key="DriverDetailLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleStyle}">
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Margin" Value="0,0,0,4"/>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Grid Margin="0,0,0,24">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,24,0">
    <TextBlock Text="Sterowniki" Style="{StaticResource PageTitleStyle}"/>
    <TextBlock Text="{Binding Status}" Style="{StaticResource SubtitleStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="Anuluj" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
    <Button Content="Sprawdź sterowniki" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="20,11"/>
   </StackPanel>
  </Grid>
  <StackPanel Grid.Row="1">
   <DockPanel Margin="0,0,0,14" Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
    <TextBox DockPanel.Dock="Right" Width="190" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Szukaj urządzenia, producenta lub identyfikatora" AutomationProperties.Name="Szukaj sterownika" Padding="10,8" Margin="12,0,0,0" VerticalAlignment="Top"/>
    <WrapPanel>
     <Button Command="{Binding SetFilterCommand}" CommandParameter="Aktualizacje">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource DriverFilterStyle}"><Style.Triggers><DataTrigger Binding="{Binding Filter}" Value="Aktualizacje"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
      <TextBlock><Run Text="Aktualizacje "/><Run Text="{Binding UpdateCount, Mode=OneWay}"/></TextBlock>
     </Button>
     <Button Command="{Binding SetFilterCommand}" CommandParameter="Zweryfikowane">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource DriverFilterStyle}"><Style.Triggers><DataTrigger Binding="{Binding Filter}" Value="Zweryfikowane"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
      <TextBlock><Run Text="Zweryfikowane "/><Run Text="{Binding VerifiedCount, Mode=OneWay}"/></TextBlock>
     </Button>
     <Button Command="{Binding SetFilterCommand}" CommandParameter="Bez potwierdzenia" ToolTip="Brak potwierdzenia nie oznacza aktualnego sterownika.">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource DriverFilterStyle}"><Style.Triggers><DataTrigger Binding="{Binding Filter}" Value="Bez potwierdzenia"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
      <TextBlock><Run Text="Bez potwierdzenia "/><Run Text="{Binding UnknownCount, Mode=OneWay}"/></TextBlock>
     </Button>
     <Button Content="Wszystkie" Command="{Binding SetFilterCommand}" CommandParameter="Wszystkie">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource DriverFilterStyle}"><Style.Triggers><DataTrigger Binding="{Binding Filter}" Value="Wszystkie"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
     </Button>
    </WrapPanel>
   </DockPanel>
   <ProgressBar IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Height="3" Margin="0,0,0,14"/>
  </StackPanel>
  <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
   <Grid>
    <ListBox ItemsSource="{Binding Results}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate>
      <Border Padding="18,12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
       <Expander HorizontalContentAlignment="Stretch" Foreground="{DynamicResource TextPrimaryBrush}">
        <Expander.Header>
         <Grid Margin="8,0,0,0" MinHeight="36">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding DeviceName}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,22,0"/>
          <Border Grid.Column="1" CornerRadius="5" Padding="8,4" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
           <TextBlock FontSize="11" Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="230" TextWrapping="Wrap"/>
          </Border>
         </Grid>
        </Expander.Header>
        <StackPanel Margin="30,18,0,4">
         <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
           <TextBlock Text="Zainstalowana wersja" Style="{StaticResource DriverDetailLabelStyle}"/>
           <TextBlock Text="{Binding InstalledVersion}" FontWeight="SemiBold"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
           <TextBlock Text="Wersja w katalogu" Style="{StaticResource DriverDetailLabelStyle}"/>
           <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding LatestVersion}"/><Style.Triggers><DataTrigger Binding="{Binding LatestVersion}" Value=""><Setter Property="Text" Value="Niepotwierdzona"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
           </TextBlock>
           <TextBlock Text="{Binding ReleaseDate}" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
          </StackPanel>
          <Button Grid.Column="2" Content="Strona producenta" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanOpenSource}" Click="OpenSource_Click" Tag="{Binding}" VerticalAlignment="Top"/>
         </Grid>
         <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Style="{StaticResource SubtitleStyle}"/>
         <TextBlock Text="{Binding SourceName}" Margin="0,8,0,0" Style="{StaticResource DriverDetailLabelStyle}"/>
         <TextBlock Text="{Binding DeviceId}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
         <TextBlock Text="{Binding CheckedAt, StringFormat=Sprawdzono: {0:dd.MM.yyyy HH:mm}}" FontSize="11" Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
       </Expander>
      </Border>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28" MaxWidth="500">
     <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource SectionTitleStyle}" TextAlignment="Center" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding EmptyDescription}" Style="{StaticResource SubtitleStyle}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <DockPanel Grid.Row="3" Margin="0,12,0,0">
   <Button DockPanel.Dock="Right" Content="Opcje zaawansowane" Click="Advanced_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="12,7" Margin="16,0,0,0"/>
   <TextBlock Text="Porównanie online: obsługiwane karty NVIDIA. Pozostałe urządzenia: weryfikacja u producenta." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
  </DockPanel>
 </Grid>
</UserControl>
